-+            if step % 100 == 0 && step > 0 {
-+                let elapsed = CFAbsoluteTimeGetCurrent() - genStart
-+                print("[T3-Turbo] Step \(step)/\(maxNewTokens) (\(generatedIds.count) tokens, \(String(format: "%.2f", elapsed))s)")
