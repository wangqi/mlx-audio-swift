-+            // Regular (LLaMA): custom EnTokenizer — wrap with SOT/EOT
-+            var ids = [Int32(sotToken)]
-+            ids.append(contentsOf: encoded.map { Int32($0) })
-+            ids.append(Int32(eotToken))
-+            return MLXArray(ids)
-+        }
-+    }
