-+private final class MossResidualLFQ: Module {
-+    let inputDim: Int
-+    let rvqDim: Int
-+    let outputDim: Int
-+    let numQuantizers: Int
-+    let codebookSize: Int
-+    let codebookDim: Int
-+
-+    @ModuleInfo(key: "input_proj") var inputProj: MossWNConv1d
-+    @ModuleInfo(key: "output_proj") var outputProj: MossWNConv1d
