++        "K": "k",
++        "L": "l",
++        "M": "m",
++        "N": "n",
++        "NG": "ŋ",
++        "P": "p",
++        "R": "ɹ",
++        "S": "s",
++        "SH": "ʃ",
++        "T": "t",
++        "TH": "θ",
++        "V": "v",
++        "W": "w",
++        "Y": "j",
++        "Z": "z",
++        "ZH": "ʒ",
++    ]
 +}
