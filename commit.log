-+                options: .regularExpression)
-+        }
-+
-+        // --- 8. Downsample/Upsample: bare Conv1d → S3GenConv1dPT/S3GenConvTranspose1dPT ---
-+        // Python Downsample1D: .downsample.conv.weight (nn.Conv1d is self.conv)
