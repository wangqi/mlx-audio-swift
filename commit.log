-+        let encoded = tokenizer.encode(text: text)
-+
-+        if config.meanflow {
-+            // Turbo: GPT-2 tokenizer — use raw token IDs, no SOT/EOT wrapping
-+            let ids = encoded.map { Int32($0) }
