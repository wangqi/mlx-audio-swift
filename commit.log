++  private let midNumWords: [(Int, String)] = [
++    (1000, "thousand"), (100, "hundred"),
++    (90, "ninety"), (80, "eighty"), (70, "seventy"),
++    (60, "sixty"), (50, "fifty"), (40, "forty"),
++    (30, "thirty")
