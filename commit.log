-+    // MARK: - Inference (Turbo)
-+
-+    /// Generate speech tokens using Turbo inference (no CFG).
-+    ///
-+    /// Matches Python's `inference_turbo` method.
-+    public func inference(
-+        t3Cond: inout T3Cond,
-+        textTokens: MLXArray,
