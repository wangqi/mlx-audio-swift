diff --git a/Sources/MLXAudioTTS/Models/Maya2/Maya2Configuration.swift b/Sources/MLXAudioTTS/Models/Maya2/Maya2Configuration.swift
new file mode 100644
index 0000000..de4dd51
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Maya2/Maya2Configuration.swift
@@ -0,0 +1,101 @@
+import Foundation
+import MLXAudioCore
+
+public struct Maya2DepthConfiguration: Codable, Sendable {
+    public var hiddenSize = 1024
+    public var numAttentionHeads = 16
+    public var intermediateSize = 3072
+    public var numHiddenLayers = 4
+    public var embeddingRank = 128
+
+    public init() {}
+    enum CodingKeys: String, CodingKey {
+        case hiddenSize = "hidden_size", numAttentionHeads = "num_attention_heads"
+        case intermediateSize = "intermediate_size", numHiddenLayers = "num_hidden_layers"
+        case embeddingRank = "embedding_rank"
+    }
+    public init(from decoder: any Decoder) throws {
+        self.init()
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        hiddenSize = try c.decodeIfPresent(Int.self, forKey: .hiddenSize) ?? hiddenSize
+        numAttentionHeads = try c.decodeIfPresent(Int.self, forKey: .numAttentionHeads) ?? numAttentionHeads
+        intermediateSize = try c.decodeIfPresent(Int.self, forKey: .intermediateSize) ?? intermediateSize
+        numHiddenLayers = try c.decodeIfPresent(Int.self, forKey: .numHiddenLayers) ?? numHiddenLayers
+        embeddingRank = try c.decodeIfPresent(Int.self, forKey: .embeddingRank) ?? embeddingRank
+    }
+}
+
+public struct Maya2Configuration: Decodable, Sendable {
+    public var backbone = Qwen3Configuration(hiddenSize: 2048, hiddenLayers: 28,
+        intermediateSize: 6144, attentionHeads: 16, kvHeads: 8, headDim: 128,
+        vocabularySize: 194548, rmsNormEps: 1e-6, ropeTheta: 1_000_000, tieWordEmbeddings: true)
+    public var depth = Maya2DepthConfiguration()
+    public var numCodebooks = 32
+    public var codebookSize = 2048
+    public var sampleRate = 24000
+    public var frameRate: Double = 12.5
+    public var speakerDim = 192
+    public var speakerAnchorHidden = 512
+    public var speakerAnchorEnabled = true
+    public var codecRepo = "kyutai/moshiko-pytorch-bf16"
+    public var codecFilename = "tokenizer-e351c8d8-checkpoint125.safetensors"
+    public var speakerEncoderRepo = "aufklarer/SpeechBrain-ECAPA-VoxCeleb-20M-MLX"
+    public var quantization: BaseConfiguration.Quantization?
+
+    public init() {}
+    enum CodingKeys: String, CodingKey {
+        case backbone = "backbone_config", depth = "depth_config", numCodebooks = "num_codebooks"
+        case codebookSize = "codebook_size", sampleRate = "sample_rate", frameRate = "frame_rate"
+        case speakerDim = "speaker_dim", speakerAnchorHidden = "speaker_anchor_hidden"
+        case speakerAnchorEnabled = "speaker_anchor_enabled", codecRepo = "codec_repo"
+        case codecFilename = "codec_filename", speakerEncoderRepo = "speaker_encoder_repo"
+        case quantization
+    }
+    public init(from decoder: any Decoder) throws {
+        self.init()
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        backbone = try c.decodeIfPresent(Qwen3Configuration.self, forKey: .backbone) ?? backbone
+        depth = try c.decodeIfPresent(Maya2DepthConfiguration.self, forKey: .depth) ?? depth
+        numCodebooks = try c.decodeIfPresent(Int.self, forKey: .numCodebooks) ?? numCodebooks
+        codebookSize = try c.decodeIfPresent(Int.self, forKey: .codebookSize) ?? codebookSize
+        sampleRate = try c.decodeIfPresent(Int.self, forKey: .sampleRate) ?? sampleRate
+        frameRate = try c.decodeIfPresent(Double.self, forKey: .frameRate) ?? frameRate
+        speakerDim = try c.decodeIfPresent(Int.self, forKey: .speakerDim) ?? speakerDim
+        speakerAnchorHidden = try c.decodeIfPresent(Int.self, forKey: .speakerAnchorHidden) ?? speakerAnchorHidden
+        speakerAnchorEnabled = try c.decodeIfPresent(Bool.self, forKey: .speakerAnchorEnabled) ?? speakerAnchorEnabled
+        codecRepo = try c.decodeIfPresent(String.self, forKey: .codecRepo) ?? codecRepo
+        codecFilename = try c.decodeIfPresent(String.self, forKey: .codecFilename) ?? codecFilename
+        speakerEncoderRepo = try c.decodeIfPresent(String.self, forKey: .speakerEncoderRepo) ?? speakerEncoderRepo
+        quantization = try c.decodeIfPresent(BaseConfiguration.Quantization.self, forKey: .quantization)
+    }
+
+    func validate() throws {
+        let b = backbone, d = depth
+        guard (2...32).contains(numCodebooks), codebookSize > 0, sampleRate == 24000,
+              frameRate == 12.5, speakerDim > 0, speakerAnchorHidden > 0,
+              b.hiddenSize > 0, b.hiddenLayers > 0, b.intermediateSize > 0,
+              b.attentionHeads > 0, b.kvHeads > 0, b.headDim > 0,
+              b.attentionHeads % b.kvHeads == 0, b.headDim % 2 == 0,
+              b.vocabularySize > 0, b.maxPositionEmbeddings > 0,
+              d.hiddenSize > 0, d.numAttentionHeads > 0,
+              d.hiddenSize % d.numAttentionHeads == 0, d.numHiddenLayers > 0,
+              d.intermediateSize > 0, d.embeddingRank > 0,
+              codecFilename == URL(fileURLWithPath: codecFilename).lastPathComponent,
+              codecFilename.hasSuffix(".safetensors") else {
+            throw AudioGenerationError.invalidInput("Invalid Maya-2 architecture or codec configuration")
+        }
+    }
+}
+
+public struct Maya2GenerationOptions: Sendable {
+    public enum Conditioning: String, Sendable { case inContextAndSpeaker = "icl_spk", inContext = "icl", speaker = "spk" }
+    public var referenceLanguage: String?
+    public var conditioning: Conditioning = .inContextAndSpeaker
+    public var depthTemperature: Float = 0.7
+    public var depthTopK = 64
+    public var presencePenalty: Float = 0.8
+    public var presenceWindow = 12
+    public var minTokens = 2
+    public var normalizeText = true
+    public init() {}
+}
diff --git a/Sources/MLXAudioTTS/Models/Maya2/Maya2Layers.swift b/Sources/MLXAudioTTS/Models/Maya2/Maya2Layers.swift
new file mode 100644
index 0000000..a68e28a
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Maya2/Maya2Layers.swift
@@ -0,0 +1,185 @@
+import MLX
+import MLXNN
+import MLXAudioCore
+
+final class Maya2AudioInput: Module {
+    let codebookSize: Int
+    let table: Embedding
+    @ParameterInfo(key: "aeos_in") var aeosIn: MLXArray
+    let norm: RMSNorm
+
+    init(_ c: Maya2Configuration) {
+        codebookSize = c.codebookSize
+        table = Embedding(embeddingCount: c.numCodebooks * c.codebookSize, dimensions: c.backbone.hiddenSize)
+        _aeosIn.wrappedValue = .zeros([c.backbone.hiddenSize])
+        norm = RMSNorm(dimensions: c.backbone.hiddenSize, eps: Float.ulpOfOne)
+    }
+    func frames(_ codes: MLXArray) -> MLXArray {
+        let q = codes.dim(-1)
+        return norm(sum(table(codes + MLXArray(0..<q) * codebookSize), axis: -2) / Float(q).squareRoot())
+    }
+    func aeos() -> MLXArray { norm(aeosIn) }
+}
+
+final class Maya2SpeakerAnchor: Module {
+    let fc1: Linear
+    let fc2: Linear
+    @ParameterInfo(key: "null_vec") var nullVec: MLXArray
+
+    init(_ c: Maya2Configuration) {
+        fc1 = Linear(c.speakerDim, c.speakerAnchorHidden)
+        fc2 = Linear(c.speakerAnchorHidden, c.backbone.hiddenSize)
+        _nullVec.wrappedValue = .zeros([c.speakerDim])
+    }
+    func callAsFunction(_ refs: MLXArray? = nil) -> MLXArray {
+        let x = refs.map { mean($0.asType(.float32), axis: 1) } ?? nullVec.expandedDimensions(axis: 0)
+        return fc2(gelu(fc1(x.asType(nullVec.dtype))))
+    }
+}
+
+final class Maya2LanguageModel: Module {
+    let model: Qwen3ModelInner
+    @ModuleInfo(key: "lm_head") var lmHead: Linear?
+    init(_ c: Qwen3Configuration) {
+        model = Qwen3ModelInner(c)
+        _lmHead.wrappedValue = c.tieWordEmbeddings ? nil : Linear(c.hiddenSize, c.vocabularySize, bias: false)
+    }
+}
+
+final class Maya2Backbone: Module {
+    let lm: Maya2LanguageModel
+    @ModuleInfo(key: "cb0_head") var cb0Head: Linear
+    init(_ c: Maya2Configuration) {
+        lm = Maya2LanguageModel(c.backbone)
+        _cb0Head.wrappedValue = Linear(c.backbone.hiddenSize, c.codebookSize + 1, bias: false)
+    }
+    func callAsFunction(_ embeddings: MLXArray, cache: [KVCache]? = nil) -> (MLXArray, MLXArray) {
+        let h = lm.model(inputEmbeddings: embeddings, cache: cache)
+        return (h, cb0Head(h))
+    }
+}
+
+final class Maya2DepthSelfBlock: Module {
+    let n1: LayerNorm
+    let n2: LayerNorm
+    let qkv: Linear
+    let o: Linear
+    let f1: Linear
+    let f2: Linear
+    let heads: Int
+    init(_ c: Maya2DepthConfiguration) {
+        let d = c.hiddenSize
+        heads = c.numAttentionHeads
+        n1 = LayerNorm(dimensions: d); n2 = LayerNorm(dimensions: d)
+        qkv = Linear(d, 3 * d, bias: false); o = Linear(d, d, bias: false)
+        f1 = Linear(d, c.intermediateSize, bias: false); f2 = Linear(c.intermediateSize, d, bias: false)
+    }
+    func callAsFunction(_ x: MLXArray, cache: KVCache? = nil) -> MLXArray {
+        let b = x.dim(0), t = x.dim(1), d = x.dim(2)
+        let qkv = split(qkv(n1(x)), parts: 3, axis: -1).map {
+            $0.reshaped(b, t, heads, -1).transposed(0, 2, 1, 3)
+        }
+        let a = attentionWithCacheUpdate(queries: qkv[0], keys: qkv[1], values: qkv[2],
+            cache: cache, scale: 1 / Float(d / heads).squareRoot(), mask: t > 1 ? .causal : .none)
+        let h = x + o(a.transposed(0, 2, 1, 3).reshaped(b, t, d))
+        return h + f2(gelu(f1(n2(h))))
+    }
+}
+
+final class Maya2DepthCrossBlock: Module {
+    let n: LayerNorm
+    let q: Linear
+    let kv: Linear
+    let o: Linear
+    let heads: Int
+    init(_ c: Maya2DepthConfiguration) {
+        let d = c.hiddenSize
+        heads = c.numAttentionHeads; n = LayerNorm(dimensions: d)
+        q = Linear(d, d, bias: false); kv = Linear(d, 2 * d, bias: false); o = Linear(d, d, bias: false)
+    }
+    func callAsFunction(_ x: MLXArray, memory: MLXArray) -> MLXArray {
+        if memory.dim(1) == 1 { return x + o(split(kv(memory), parts: 2, axis: -1)[1]) }
+        let b = x.dim(0), t = x.dim(1), d = x.dim(2), s = memory.dim(1)
+        let query = q(n(x)).reshaped(b, t, heads, -1).transposed(0, 2, 1, 3)
+        let pair = split(kv(memory), parts: 2, axis: -1).map { $0.reshaped(b, s, heads, -1).transposed(0, 2, 1, 3) }
+        let a = MLXFast.scaledDotProductAttention(queries: query, keys: pair[0], values: pair[1], scale: 1 / Float(d / heads).squareRoot(), mask: .none)
+        return x + o(a.transposed(0, 2, 1, 3).reshaped(b, t, d))
+    }
+}
+
+final class Maya2DepthDecoder: Module {
+    static let groupOfLevel = [-1] + Array(0..<8) + Array(repeating: 8, count: 8)
+        + Array(repeating: 9, count: 8) + Array(repeating: 10, count: 7)
+    let numCodebooks: Int
+    let codebookSize: Int
+    @ModuleInfo(key: "in_proj") var inProj: Linear
+    @ModuleInfo(key: "code_lo") var codeLo: Embedding
+    @ModuleInfo(key: "code_up") var codeUp: Linear
+    @ModuleInfo(key: "level_emb") var levelEmb: Embedding
+    let groups: [[Maya2DepthSelfBlock]]
+    let cross: [Maya2DepthCrossBlock]
+    let norm: LayerNorm
+    let heads: [Linear]
+    @ModuleInfo(key: "spk_proj_campp") var spkProjCampp: Linear
+    @ModuleInfo(key: "spk_proj_ecapa") var spkProjEcapa: Linear
+    @ParameterInfo(key: "null_mem") var nullMem: MLXArray
+
+    init(_ c: Maya2Configuration) {
+        let d = c.depth.hiddenSize
+        numCodebooks = c.numCodebooks; codebookSize = c.codebookSize
+        _inProj.wrappedValue = Linear(c.backbone.hiddenSize, d, bias: false)
+        _codeLo.wrappedValue = Embedding(embeddingCount: (c.numCodebooks - 1) * c.codebookSize, dimensions: c.depth.embeddingRank)
+        _codeUp.wrappedValue = Linear(c.depth.embeddingRank, d, bias: false)
+        _levelEmb.wrappedValue = Embedding(embeddingCount: c.numCodebooks, dimensions: d)
+        groups = (0...Self.groupOfLevel[c.numCodebooks - 1]).map { _ in
+            (0..<c.depth.numHiddenLayers).map { _ in Maya2DepthSelfBlock(c.depth) }
+        }
+        cross = (0..<c.depth.numHiddenLayers).map { _ in Maya2DepthCrossBlock(c.depth) }
+        norm = LayerNorm(dimensions: d)
+        heads = (1..<c.numCodebooks).map { _ in Linear(d, c.codebookSize, bias: false) }
+        _spkProjCampp.wrappedValue = Linear(1024, d, bias: false)
+        _spkProjEcapa.wrappedValue = Linear(c.speakerDim, d, bias: false)
+        _nullMem.wrappedValue = .zeros([1, 1, d])
+    }
+    func speakerMemory(_ refs: MLXArray? = nil) -> MLXArray {
+        refs.map { spkProjEcapa($0.asType(nullMem.dtype)) } ?? nullMem
+    }
+    func prefix(hidden: MLXArray, codes: MLXArray, level: Int) -> MLXArray {
+        let slots = MLXArray(0..<level)
+        let h = inProj(hidden.asType(nullMem.dtype)).expandedDimensions(axis: 1)
+        let e = codeUp(codeLo(codes[0..., ..<level] + slots * codebookSize))
+        return concatenated([h + levelEmb.weight[..<1], e + levelEmb(slots + 1)], axis: 1)
+    }
+    func run(_ x: MLXArray, group: Int, memory: MLXArray, cache: [KVCache]? = nil) -> MLXArray {
+        var h = x
+        for i in cross.indices { h = cross[i](groups[group][i](h, cache: cache?[i]), memory: memory) }
+        return norm(h[0..., -1, 0...])
+    }
+    func callAsFunction(hidden: MLXArray, codes: MLXArray, memory: MLXArray? = nil) -> [MLXArray] {
+        let mem = memory ?? speakerMemory()
+        return (1..<codes.dim(1)).map { level in
+            heads[level - 1](run(prefix(hidden: hidden, codes: codes, level: level),
+                group: Self.groupOfLevel[level], memory: mem))
+        }
+    }
+    func generate(hidden: MLXArray, cb0: MLXArray, memory: MLXArray, temperature: Float, topK: Int, sampler providedSampler: (any LogitSampler)? = nil) -> MLXArray {
+        var codes = [cb0], previous = -1
+        var cache: [KVCache] = []
+        let sampler = providedSampler ?? GenerateParameters(temperature: temperature, topK: min(topK, codebookSize)).sampler()
+        for level in 1..<numCodebooks {
+            let group = Self.groupOfLevel[level]
+            let x: MLXArray
+            if group != previous {
+                cache = cross.map { _ in KVCacheSimple() }
+                x = prefix(hidden: hidden, codes: stacked(codes, axis: 1), level: level)
+            } else {
+                let code = codes.last! + (level - 1) * codebookSize
+                x = codeUp(codeLo(code)).expandedDimensions(axis: 1) + levelEmb.weight[level]
+            }
+            let h = run(x, group: group, memory: memory, cache: cache)
+            codes.append(sampler.sample(logits: heads[level - 1](h).asType(.float32)))
+            previous = group
+        }
+        return stacked(codes, axis: 1)
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Maya2/Maya2Loading.swift b/Sources/MLXAudioTTS/Models/Maya2/Maya2Loading.swift
new file mode 100644
index 0000000..5e8ec18
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Maya2/Maya2Loading.swift
@@ -0,0 +1,98 @@
+import Foundation
+import HuggingFace
+import MLX
+import MLXNN
+import MLXAudioCore
+import MLXAudioCodecs
+import Tokenizers
+
+extension Maya2Model {
+    static func configuration(from directory: URL) throws -> Maya2Configuration {
+        let root = try Data(contentsOf: directory.appendingPathComponent("config.json"))
+        let raw = try JSONSerialization.jsonObject(with: root) as? [String: Any] ?? [:]
+        var c = try JSONDecoder().decode(Maya2Configuration.self, from: root)
+        if raw["backbone_config"] == nil {
+            let file = directory.appendingPathComponent("backbone/config.json")
+            var config = try JSONSerialization.jsonObject(with: Data(contentsOf: file)) as? [String: Any] ?? [:]
+            if let rope = config["rope_parameters"] as? [String: Any], let theta = rope["rope_theta"] {
+                config["rope_theta"] = theta
+            }
+            c.backbone = try JSONDecoder().decode(Qwen3Configuration.self, from: JSONSerialization.data(withJSONObject: config))
+            let sidecar = directory.appendingPathComponent("maya3_config.json")
+            if FileManager.default.fileExists(atPath: sidecar.path),
+               let data = try JSONSerialization.jsonObject(with: Data(contentsOf: sidecar)) as? [String: Any],
+               let model = data["model"] as? [String: Any] {
+                let anchor = model["speaker_anchor"] as? [String: Any] ?? [:]
+                c.speakerAnchorEnabled = anchor["enabled"] as? Bool ?? false
+                c.speakerAnchorHidden = anchor["hidden"] as? Int ?? 512
+                c.speakerDim = anchor["input_dim"] as? Int ?? 192
+            }
+        }
+        try c.validate()
+        return c
+    }
+
+    func sanitize(weights: [String: MLXArray]) -> [String: MLXArray] {
+        var result: [String: MLXArray] = [:]
+        for (raw, value) in weights {
+            let key = raw.hasPrefix("model.") ? String(raw.dropFirst(6)) : raw
+            if key == "backbone.lm.lm_head.weight", configuration.backbone.tieWordEmbeddings { continue }
+            result[key] = key.hasPrefix("depth.") && value.dtype.isFloatingPoint ? value.asType(.float16) : value
+        }
+        return result
+    }
+
+    public static func fromPretrained(_ repository: String, cache: HubCache = .default) async throws -> Maya2Model {
+        guard let id = Repo.ID(rawValue: repository) else { throw TTSModelError.invalidRepositoryID(repository) }
+        let directory = try await ModelUtils.resolveOrDownloadModel(repoID: id, requiredExtension: "safetensors",
+            additionalMatchingPatterns: ["backbone/*.json", "backbone/*.model", "voices/*.json"], cache: cache)
+        return try await fromModelDirectory(directory, cache: cache)
+    }
+
+    public static func fromModelDirectory(_ directory: URL, cache: HubCache = .default) async throws -> Maya2Model {
+        let config = try configuration(from: directory)
+        let model = Maya2Model(config)
+        let index = directory.appendingPathComponent("model.safetensors.index.json")
+        let files: [URL]
+        if FileManager.default.fileExists(atPath: index.path) {
+            struct Index: Decodable { let weight_map: [String: String] }
+            let names = Set(try JSONDecoder().decode(Index.self, from: Data(contentsOf: index)).weight_map.values)
+            guard names.allSatisfy({ $0 == URL(fileURLWithPath: $0).lastPathComponent && $0.hasSuffix(".safetensors") }) else {
+                throw AudioGenerationError.invalidInput("Invalid Maya-2 shard index")
+            }
+            files = names.sorted().map { directory.appendingPathComponent($0) }
+        } else { files = [directory.appendingPathComponent("model.safetensors")] }
+        var weights: [String: MLXArray] = [:]
+        for file in files {
+            for (key, value) in try loadArrays(url: file) {
+                guard weights[key] == nil else { throw AudioGenerationError.invalidInput("Duplicate Maya-2 tensor: \(key)") }
+                weights[key] = value
+            }
+        }
+        weights = model.sanitize(weights: weights)
+        if let q = config.quantization {
+            quantize(model: model) { path, _ in
+                guard path.hasPrefix("backbone.lm."), weights["\(path).scales"] != nil else { return nil }
+                return q.asTuple
+            }
+        }
+        try model.update(parameters: ModuleParameters.unflattened(weights), verify: .all)
+        model.train(false); eval(model)
+        model._tokenizer = try await AutoTokenizer.from(modelFolder: directory.appendingPathComponent("backbone"))
+        for lang in languages {
+            guard let id = model._tokenizer?.convertTokenToId("<|lang:\(lang)|>"), id >= 0, id < config.backbone.vocabularySize else {
+                throw AudioGenerationError.invalidInput("Missing Maya-2 language control token: \(lang)")
+            }
+        }
+        model._cache = cache
+        model._directory = directory
+        let localCodec = directory.appendingPathComponent("mimi")
+        if FileManager.default.fileExists(atPath: localCodec.path) {
+            model._codec = try Mimi.fromModelDirectory(localCodec, filename: config.codecFilename)
+        } else {
+            model._codec = try await Mimi.fromPretrained(repoId: config.codecRepo, filename: config.codecFilename,
+                cache: cache, progressHandler: { _ in })
+        }
+        return model
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Maya2/Maya2Model.swift b/Sources/MLXAudioTTS/Models/Maya2/Maya2Model.swift
new file mode 100644
index 0000000..fe8db4e
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Maya2/Maya2Model.swift
@@ -0,0 +1,232 @@
+import Foundation
+import HuggingFace
+@preconcurrency import MLX
+import MLXNN
+import MLXAudioCore
+import MLXAudioCodecs
+import Tokenizers
+
+private final class Maya2GenerationOwner: Sendable {}
+
+/// Maya-2 Native multilingual speech synthesis. Low-level forward calls require serialized use.
+public final class Maya2Model: Module, SpeechGenerationModel, @unchecked Sendable {
+    public static let languages = ["as", "bn", "en", "gu", "hi", "kn", "ml", "mr", "or", "pa", "ta", "te"]
+    public static let builtInVoices = ["Ahana", "Vaidehi", "Malini", "Charvi", "Jahnavi", "Anirban", "Nakul", "Vasant", "Siddhant", "Satvik", "Abhay", "Nivedita", "Ishwari", "Ritvik", "Vrinda", "Sreekar", "Kayal", "Shaunak", "Akshat", "Tanushree"]
+    public var voices: [String] { Self.builtInVoices }
+    public let configuration: Maya2Configuration
+    let backbone: Maya2Backbone
+    let depth: Maya2DepthDecoder
+    @ModuleInfo(key: "audio_in") var audioIn: Maya2AudioInput
+    @ModuleInfo(key: "speaker_anchor") var speakerAnchor: Maya2SpeakerAnchor?
+    var _tokenizer: (any Tokenizer)?
+    var _codec: Mimi?
+    var _speakerEncoder: EcapaSpeakerEncoder?
+    var _directory: URL?
+    var _cache: HubCache = .default
+    private let _generationCache = TTSGenerationCache()
+    private let _generationOwner = Maya2GenerationOwner()
+
+    public init(_ configuration: Maya2Configuration) {
+        self.configuration = configuration
+        backbone = Maya2Backbone(configuration); depth = Maya2DepthDecoder(configuration)
+        _audioIn.wrappedValue = Maya2AudioInput(configuration)
+        _speakerAnchor.wrappedValue = configuration.speakerAnchorEnabled ? Maya2SpeakerAnchor(configuration) : nil
+    }
+    public var sampleRate: Int { configuration.sampleRate }
+    public var defaultGenerationParameters: GenerateParameters {
+        GenerateParameters(maxTokens: 1500, temperature: 0.9, topP: 1, topK: 64)
+    }
+    func composeInputs(_ prompt: Maya2Prompt, references: MLXArray? = nil) -> MLXArray {
+        let x = backbone.lm.model.embedTokens(MLXArray(prompt.tokens).expandedDimensions(axis: 0))
+        let positions = prompt.kinds.indices.filter { prompt.kinds[$0] == 1 }
+        if !positions.isEmpty {
+            let codes = MLXArray(positions.flatMap { prompt.codes[$0] }).reshaped(positions.count, configuration.numCodebooks)
+            x[0, MLXArray(positions), 0...] = audioIn.frames(codes).asType(x.dtype)
+        }
+        for pos in prompt.kinds.indices where prompt.kinds[pos] == 3 { x[0, pos, 0...] = audioIn.aeos().asType(x.dtype) }
+        if let speakerAnchor {
+            let anchor = speakerAnchor(references).asType(x.dtype)
+            for pos in prompt.sentinels { x[0..., pos, 0...] = x[0..., pos, 0...] + anchor }
+        }
+        return x
+    }
+    func callAsFunction(_ embeddings: MLXArray, cache: [KVCache]? = nil) -> (MLXArray, MLXArray) {
+        backbone(embeddings, cache: cache)
+    }
+
+    private func reference(_ audio: MLXArray, options: Maya2GenerationOptions) async throws -> (MLXArray?, MLXArray?) {
+        guard audio.ndim == 1, audio.size >= sampleRate / 10, all(isFinite(audio)).item(Bool.self) else {
+            throw AudioGenerationError.invalidInput("Reference must contain at least 0.1 seconds of finite mono 24 kHz audio")
+        }
+        var codes: MLXArray?, refs: MLXArray?
+        if options.conditioning != .speaker {
+            guard let codec = _codec else { throw AudioGenerationError.modelNotInitialized("Maya-2 Mimi codec is required") }
+            codes = codec.encode(audio.asType(.float32).reshaped(1, 1, -1))[0]
+            eval(codes!)
+        }
+        if options.conditioning != .inContext {
+            if _speakerEncoder == nil {
+                if let local = _directory?.appendingPathComponent("speaker_encoder/model.safetensors"), FileManager.default.fileExists(atPath: local.path) {
+                    _speakerEncoder = try EcapaSpeakerEncoder.fromWeights(local)
+                } else {
+                    _speakerEncoder = try await EcapaSpeakerEncoder.fromPretrained(configuration.speakerEncoderRepo, cache: _cache)
+                }
+            }
+            let samples = try resampleAudio(audio.asArray(Float.self), from: sampleRate, to: 16000)
+            refs = try _speakerEncoder!.encode(MLXArray(samples)).reshaped(1, 1, -1)
+            eval(refs!)
+        }
+        return (codes, refs)
+    }
+
+    public func generate(text: String, voice: String?, refAudio: MaterializedArray?, refText: String?,
+                         language: String?, generationParameters: GenerateParameters) async throws -> MaterializedArray {
+        try await generate(text: text, voice: voice, refAudio: refAudio, refText: refText,
+            language: language ?? "en", parameters: generationParameters)
+    }
+    public func generate(text: String, voice: String? = nil, refAudio: MaterializedArray? = nil,
+                         refText: String? = nil, language: String = "en", options: Maya2GenerationOptions = .init(),
+                         parameters: GenerateParameters? = nil) async throws -> MaterializedArray {
+        try await _generationCache.withCache(model: _generationOwner, makeCache: { [] }) { _ in
+            try await self.run(text: text, voice: voice, refAudio: refAudio, refText: refText, language: language,
+                options: options, parameters: parameters ?? self.defaultGenerationParameters, streamingInterval: nil, emit: { _ in })!
+        }
+    }
+    public func generateStream(text: String, voice: String?, refAudio: MaterializedArray?, refText: String?,
+                               language: String?, generationParameters: GenerateParameters) -> AsyncThrowingStream<AudioGeneration, Error> {
+        generateStream(text: text, voice: voice, refAudio: refAudio, refText: refText,
+            language: language ?? "en", parameters: generationParameters)
+    }
+    public func generateStream(text: String, voice: String?, refAudio: MaterializedArray?, refText: String?,
+                               language: String?, generationParameters: GenerateParameters,
+                               streamingInterval: Double) -> AsyncThrowingStream<AudioGeneration, Error> {
+        generateStream(text: text, voice: voice, refAudio: refAudio, refText: refText,
+            language: language ?? "en", parameters: generationParameters, streamingInterval: streamingInterval)
+    }
+    public func generateStream(text: String, voice: String? = nil, refAudio: MaterializedArray? = nil,
+                               refText: String? = nil, language: String = "en", options: Maya2GenerationOptions = .init(),
+                               parameters: GenerateParameters? = nil, streamingInterval: Double = 0.32) -> AsyncThrowingStream<AudioGeneration, Error> {
+        let (stream, continuation) = AsyncThrowingStream<AudioGeneration, Error>.makeStream()
+        let task = Task.detached { @Sendable [self] in
+            do {
+                try await _generationCache.withCache(model: _generationOwner, makeCache: { [] }) { _ in
+                    _ = try await self.run(text: text, voice: voice, refAudio: refAudio, refText: refText, language: language,
+                        options: options, parameters: parameters ?? self.defaultGenerationParameters,
+                        streamingInterval: streamingInterval, emit: { continuation.yield($0) })
+                }
+                continuation.finish()
+            } catch { continuation.finish(throwing: error) }
+        }
+        continuation.onTermination = { @Sendable _ in task.cancel() }
+        return stream
+    }
+
+    static func filteredLogits(_ logits: MLXArray, history: [Int], parameters: GenerateParameters, options: Maya2GenerationOptions) -> MLXArray {
+        var scaled = logits.asType(.float32) / (parameters.temperature == 0 ? 1 : parameters.temperature)
+        if !history.isEmpty, options.presenceWindow > 0, options.presencePenalty != 0 {
+            let ids = MLXArray(Array(Set(history.suffix(options.presenceWindow))).sorted())
+            scaled[0..., ids] = scaled[0..., ids] - options.presencePenalty
+        }
+        if parameters.topK > 0 {
+            let threshold = sorted(scaled, axis: -1)[0..., (-min(parameters.topK, scaled.dim(-1)))...][0..., ..<1]
+            scaled = MLX.where(scaled .< threshold, -Float.infinity, scaled)
+        }
+        if parameters.topP < 1 {
+            let indices = argSort(scaled, axis: -1)
+            let probabilities = takeAlong(softmax(scaled, axis: -1), indices, axis: -1)
+            let keep = cumsum(probabilities, axis: -1) .> (1 - parameters.topP)
+            scaled = putAlong(scaled, indices, values: MLX.where(keep, takeAlong(scaled, indices, axis: -1), -Float.infinity), axis: -1)
+        }
+        return scaled
+    }
+
+    private func run(text: String, voice: String?, refAudio: MaterializedArray?, refText: String?, language: String,
+                     options: Maya2GenerationOptions, parameters: GenerateParameters, streamingInterval: Double?,
+                     emit: (AudioGeneration) -> Void) async throws -> MaterializedArray? {
+        guard let tokenizer = _tokenizer, let codec = _codec else {
+            throw AudioGenerationError.modelNotInitialized("Load Maya-2 before generating")
+        }
+        let maxTokens = parameters.maxTokens ?? 1500
+        guard maxTokens > 0, options.minTokens >= 0, parameters.temperature.isFinite, parameters.temperature >= 0,
+              options.depthTemperature.isFinite, options.depthTemperature >= 0, parameters.topK >= 0, options.depthTopK >= 0,
+              parameters.topP > 0, parameters.topP <= 1, options.presenceWindow >= 0, options.presencePenalty.isFinite,
+              streamingInterval.map({ $0.isFinite && $0 > 0 && $0 * configuration.frameRate < Double(Int.max) }) ?? true else {
+            throw AudioGenerationError.invalidInput("Invalid Maya-2 sampling or streaming parameters")
+        }
+        guard Self.languages.contains(language) else { throw AudioGenerationError.invalidInput("Unsupported Maya-2 language: \(language)") }
+        var voice = voice, referenceCodes: MLXArray?, references: MLXArray?
+        if let refAudio {
+            guard voice == nil else { throw AudioGenerationError.invalidInput("Use either a named voice or refAudio") }
+            if options.conditioning != .speaker, refText?.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ?? true {
+                throw AudioGenerationError.invalidInput("refText is required for in-context voice cloning")
+            }
+            (referenceCodes, references) = try await reference(refAudio, options: options)
+        } else { voice = voice ?? "Ahana" }
+        if let name = voice {
+            guard let canonical = voices.first(where: { $0.caseInsensitiveCompare(name) == .orderedSame }) else {
+                throw AudioGenerationError.invalidInput("Unknown Maya-2 voice: \(name)")
+            }
+            voice = canonical
+        }
+        let text = options.normalizeText ? try Maya2TextNormalizer.normalize(text, language: language) : text
+        let prompt = try Maya2Prompt.build(text: text, language: language, voice: voice, referenceText: refText,
+            referenceCodes: referenceCodes, referenceLanguage: options.referenceLanguage, numCodebooks: configuration.numCodebooks,
+            encode: { tokenizer.encode(text: $0, addSpecialTokens: false) }, tokenID: { tokenizer.convertTokenToId($0) })
+        guard maxTokens <= configuration.backbone.maxPositionEmbeddings - prompt.tokens.count else {
+            throw AudioGenerationError.invalidInput("Prompt and maxTokens exceed the Maya-2 context length")
+        }
+        let start = Date()
+        let cache: [KVCache] = (0..<configuration.backbone.hiddenLayers).map { _ in KVCacheSimple() }
+        let memory = depth.speakerMemory(references)
+        let decoder = MimiStreamingDecoder(codec)
+        defer { decoder.reset(); codec.resetState() }
+        let chunkFrames = max(1, Int(((streamingInterval ?? 0.32) * configuration.frameRate).rounded(.toNearestOrEven)))
+        let sampler = GenerateParameters(temperature: parameters.temperature == 0 ? 0 : 1, seed: parameters.seed).sampler()
+        let depthSampler = GenerateParameters(temperature: options.depthTemperature, topK: min(options.depthTopK, configuration.codebookSize), seed: parameters.seed.map { $0 &+ 1 }).sampler()
+        var (hidden, logits) = self(composeInputs(prompt, references: references), cache: cache)
+        eval(hidden, logits)
+        let prefill = Date().timeIntervalSince(start)
+        var history: [Int] = [], pending: [MLXArray] = []
+        var hazard: Float = 0
+        for step in 0..<maxTokens {
+            try Task.checkCancellation()
+            let raw = logits[0..., -1, 0...]
+            var scaled = Self.filteredLogits(raw, history: history, parameters: parameters, options: options)
+            let probabilities = softmax(scaled, axis: -1)
+            let eos = configuration.codebookSize
+            let eosProbability = probabilities[0, eos].item(Float.self)
+            if step >= options.minTokens {
+                hazard = 1 - (1 - hazard) * (1 - eosProbability)
+                if argMax(probabilities, axis: -1).item(Int.self) == eos || eosProbability >= 0.35 || hazard >= 0.6 { break }
+            }
+            let columns = MLXArray(0...eos)
+            scaled = MLX.where(columns .== eos, -Float.infinity, scaled)
+            if !any(isFinite(scaled)).item(Bool.self) { scaled = MLX.where(columns .== eos, -Float.infinity, raw.asType(.float32)) }
+            let cb0 = sampler.sample(logits: scaled)
+            let codes = depth.generate(hidden: hidden[0..., -1, 0...], cb0: cb0, memory: memory,
+                temperature: options.depthTemperature, topK: options.depthTopK, sampler: depthSampler)
+            eval(codes)
+            let token = cb0.item(Int.self)
+            emit(.token(token)); history.append(token)
+            let audio = decoder.decodeFrames(codes.expandedDimensions(axis: -1)).reshaped(-1).asType(.float32)
+            eval(audio); pending.append(audio)
+            if streamingInterval != nil, pending.count >= chunkFrames {
+                emit(.audio(concatenated(pending).materialized())); pending.removeAll(keepingCapacity: true)
+            }
+            if step + 1 < maxTokens {
+                (hidden, logits) = self(audioIn.frames(codes).expandedDimensions(axis: 1), cache: cache)
+                eval(hidden, logits)
+            }
+        }
+        guard !history.isEmpty else { throw AudioGenerationError.generationFailed("Maya-2 generated no audio frames") }
+        let elapsed = Date().timeIntervalSince(start) - prefill
+        emit(.info(AudioGenerationInfo(promptTokenCount: prompt.tokens.count, generationTokenCount: history.count,
+            prefillTime: prefill, generateTime: elapsed, tokensPerSecond: Double(history.count) / max(elapsed, 0.001),
+            peakMemoryUsage: Double(Memory.peakMemory) / 1e9)))
+        if streamingInterval != nil {
+            if !pending.isEmpty { emit(.audio(concatenated(pending).materialized())) }
+            return nil
+        }
+        return concatenated(pending).materialized()
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Maya2/Maya2Prompt.swift b/Sources/MLXAudioTTS/Models/Maya2/Maya2Prompt.swift
new file mode 100644
index 0000000..a02b77f
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Maya2/Maya2Prompt.swift
@@ -0,0 +1,54 @@
+import Foundation
+import MLX
+import MLXAudioCore
+
+struct Maya2Prompt {
+    var tokens: [Int] = []
+    var kinds: [Int] = []
+    var codes: [[Int32]] = []
+    var sentinels: [Int] = []
+
+    static func build(text: String, language: String, voice: String?, referenceText: String?,
+                      referenceCodes: MLXArray?, referenceLanguage: String?, numCodebooks: Int,
+                      encode: (String) -> [Int], tokenID: (String) -> Int?) throws -> Self {
+        guard Maya2Model.languages.contains(language),
+              referenceLanguage.map({ Maya2Model.languages.contains($0) }) ?? true else {
+            throw AudioGenerationError.invalidInput("Supported Maya-2 languages: \(Maya2Model.languages.joined(separator: ", "))")
+        }
+        let text = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !text.isEmpty else { throw AudioGenerationError.invalidInput("Speech text must not be empty") }
+        var p = Self()
+        func control(_ name: String) throws -> Int {
+            guard let id = tokenID(name), id >= 0 else {
+                throw AudioGenerationError.invalidInput("Maya-2 tokenizer is missing \(name)")
+            }
+            return id
+        }
+        func span(_ content: String, _ lang: String?) throws {
+            let ids = (try lang.map { [try control("<|lang:\($0)|>")] } ?? [])
+                + encode(content) + [try control("<|audio|>")]
+            p.tokens += ids; p.kinds += Array(repeating: 0, count: ids.count)
+            p.codes += Array(repeating: Array(repeating: -1, count: numCodebooks), count: ids.count)
+            p.sentinels.append(p.tokens.count - 1)
+        }
+        let targetLanguage: String?
+        if let referenceCodes {
+            guard referenceCodes.ndim == 2, referenceCodes.dim(0) == numCodebooks,
+                  referenceCodes.dim(1) > 0 else { throw AudioGenerationError.invalidInput("Invalid reference code shape") }
+            guard let referenceText, !referenceText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+                throw AudioGenerationError.invalidInput("refText is required for in-context voice cloning")
+            }
+            let refLang = referenceLanguage ?? language
+            try span(referenceText, refLang)
+            let n = referenceCodes.dim(1)
+            let flat = referenceCodes.transposed().asArray(Int32.self)
+            p.tokens += Array(repeating: 0, count: n + 1)
+            p.kinds += Array(repeating: 1, count: n) + [3]
+            for i in 0..<n { p.codes.append(Array(flat[(i * numCodebooks)..<((i + 1) * numCodebooks)])) }
+            p.codes.append(Array(repeating: -1, count: numCodebooks))
+            targetLanguage = refLang == language ? nil : language
+        } else { targetLanguage = language }
+        try span(voice.map { "{\($0)}: \(text)" } ?? text, targetLanguage)
+        return p
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Maya2/Maya2TextNormalizer.swift b/Sources/MLXAudioTTS/Models/Maya2/Maya2TextNormalizer.swift
new file mode 100644
index 0000000..ebaabae
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Maya2/Maya2TextNormalizer.swift
@@ -0,0 +1,342 @@
+import Foundation
+import MLXAudioCore
+
+/// Written-to-spoken normalization for Maya-2's twelve supported languages.
+public enum Maya2TextNormalizer {
+    private struct Tables: Decodable, Sendable {
+        let uri_acronyms: [String]
+        let month_aliases: [String: Int]
+        let id_words: [String]
+        let label_words: [String]
+        let languages: [String: LanguageData]
+    }
+    private struct LanguageData: Decodable, Sendable {
+        let ones: [String], hundreds: [String], hundreds_comb: [String], year_prefix: [String]
+        let scales: [[String]], months: [String]
+        let letters: [String: String], symbols: [String: String], currency_words: [String: String]
+        let month_aliases: [String: Int], scale_words: [String: String], singular: [String: String]
+        let periods: [String: String], period_words: [String: String], ampm: [String: String]
+        let time_marker_endings: [String: [String: String]]
+        let dash: String, count_one: String, time_hour: String, time_hm: String
+        let year_words: [String], time_markers: [String]
+        let thousand_exceptions: [String: String]?
+        let scale_one: [[String]]?
+        let date_days: [String]?
+    }
+    private static let tables: Result<Tables, Error> = Result {
+        guard let url = Bundle.module.url(forResource: "maya2_normalization_data", withExtension: "json") else {
+            throw AudioGenerationError.modelNotInitialized("Maya-2 normalization tables are missing")
+        }
+        return try JSONDecoder().decode(Tables.self, from: Data(contentsOf: url))
+    }
+    private static let numberPattern = #"\d+(?:,\d+)*(?:\.\d+)?"#
+    private static let symbols = ["₹": "rupee", "$": "dollar", "€": "euro", "£": "pound"]
+    private static let currencies = ["rs": "rupee", "rs.": "rupee", "inr": "rupee", "rupees": "rupee", "rupee": "rupee", "usd": "dollar", "dollars": "dollar", "dollar": "dollar", "eur": "euro", "euro": "euro", "euros": "euro", "gbp": "pound", "pound": "pound", "pounds": "pound"]
+    private enum FormError: Error { case invalid }
+
+    private struct Match {
+        let text: String
+        let result: NSTextCheckingResult
+        var value: String { (text as NSString).substring(with: result.range) }
+        func group(_ index: Int) -> String? {
+            guard index < result.numberOfRanges, result.range(at: index).location != NSNotFound else { return nil }
+            return (text as NSString).substring(with: result.range(at: index))
+        }
+    }
+    private static func matches(_ pattern: String, _ text: String) -> [Match] {
+        guard let re = try? NSRegularExpression(pattern: pattern, options: .caseInsensitive) else { return [] }
+        return re.matches(in: text, range: NSRange(text.startIndex..., in: text)).map { Match(text: text, result: $0) }
+    }
+    private static func substitute(_ pattern: String, _ text: String, _ transform: (Match) -> String) -> String {
+        let source = text as NSString
+        var output = "", offset = 0
+        for m in matches(pattern, text) {
+            output += source.substring(with: NSRange(location: offset, length: m.result.range.location - offset)) + transform(m)
+            offset = NSMaxRange(m.result.range)
+        }
+        return output + source.substring(from: offset)
+    }
+    private static func alternatives<S: Sequence>(_ values: S) -> String where S.Element == String {
+        let values = values.sorted { $0.utf16.count > $1.utf16.count }
+        return values.isEmpty ? "(?!)" : values.map(NSRegularExpression.escapedPattern(for:)).joined(separator: "|")
+    }
+    private static func dropLastScalar(_ text: String) -> String { String(String.UnicodeScalarView(text.unicodeScalars.dropLast())) }
+    private static func dropFirstScalar(_ text: String) -> String { String(String.UnicodeScalarView(text.unicodeScalars.dropFirst())) }
+    private static func ungroup(_ value: String) throws -> String {
+        let integer = value.trimmingCharacters(in: CharacterSet(charactersIn: "+-")).components(separatedBy: ".")[0]
+        if integer.contains(","), matches(#"^(?:\d{1,3}(?:,\d{3})+|\d{1,2}(?:,\d{2})*,\d{3})$"#, integer).isEmpty {
+            throw FormError.invalid
+        }
+        return value.replacingOccurrences(of: ",", with: "")
+    }
+
+    private struct Language {
+        let code: String
+        let data: LanguageData
+        func symbol(_ key: String) -> String { data.symbols[key] ?? key }
+        func join(_ input: [String]) -> String {
+            var parts = input.filter { !$0.isEmpty }
+            if code == "ta", parts.count > 1 {
+                for i in 0..<(parts.count - 1) {
+                    if parts[i].hasSuffix("த்து") || parts[i].hasSuffix("ற்று") {
+                        let first = parts[i + 1].unicodeScalars.first.map(String.init) ?? ""
+                        if let suffix = ["க": "க்", "ச": "ச்", "த": "த்", "ப": "ப்"][first] { parts[i] += suffix }
+                    }
+                }
+            }
+            return parts.joined(separator: " ")
+        }
+        func cardinal(_ number: Int) throws -> String {
+            guard number >= 0 else { throw FormError.invalid }
+            if number < 100 { return data.ones[number] }
+            if number < 1000 {
+                let h = number / 100, rest = number % 100
+                return rest > 0 ? join([data.hundreds_comb[h - 1], data.ones[rest]]) : data.hundreds[h - 1]
+            }
+            var parts: [String] = [], value = number
+            for (index, scale) in [(2, 10_000_000), (1, 100_000), (0, 1000)] {
+                let count = value / scale
+                value %= scale
+                if count == 0 { continue }
+                let combining = value > 0 ? 1 : 0
+                var word = data.scales[index][combining]
+                if index == 0 && code == "ta" {
+                    guard count < data.ones.count else { throw FormError.invalid }
+                    if count != 1 { word = dropLastScalar(data.ones[count]) + "ா" + dropFirstScalar(word) }
+                } else if index == 0 && code == "ml" {
+                    if let exception = data.thousand_exceptions?[String(count)] { word = exception }
+                    else {
+                        guard count < data.ones.count else { throw FormError.invalid }
+                        let base = data.ones[count]
+                        word = base.unicodeScalars.last?.value == 0x0D4D
+                            ? dropLastScalar(base) + (base.hasSuffix("ത്") ? "ിനായിരം" : "ായിരം")
+                            : base + " " + data.scales[0][0]
+                    }
+                    if combining == 1 { word = dropLastScalar(word) + "ത്തി" }
+                } else if code == "te" && count == 1, let one = data.scale_one { word = one[index][combining] }
+                else if !(code == "kn" && index == 0 && count == 1 && parts.isEmpty) {
+                    let multiplier = count == 1 && ["ta", "ml"].contains(code) ? data.count_one : try cardinal(count)
+                    word = multiplier + " " + word
+                }
+                parts.append(word)
+            }
+            if value > 0 { parts.append(try cardinal(value)) }
+            return join(parts)
+        }
+        func year(_ value: Int) throws -> String {
+            if !data.year_prefix.isEmpty, (1100...1999).contains(value) {
+                let h = value / 100, rest = value % 100
+                if code == "te" && rest == 0 { return data.year_prefix[h - 11] + "ు" }
+                return data.year_prefix[h - 11] + (rest > 0 ? " " + data.ones[rest] : "")
+            }
+            return try cardinal(value)
+        }
+        func digits(_ value: String, comma: Bool = true) -> String {
+            value.compactMap { $0.wholeNumberValue }.map { data.ones[$0] }.joined(separator: comma ? ", " : " ")
+        }
+        func oblique(_ words: String) -> String { code == "te" && words.hasSuffix("లు") ? dropLastScalar(words) : words }
+        func number(_ input: String) throws -> String {
+            var value = try ungroup(input)
+            let sign = value.hasPrefix("-") ? symbol("minus") : value.hasPrefix("+") ? symbol("plus") : ""
+            value = value.trimmingCharacters(in: CharacterSet(charactersIn: "+-"))
+            let parts = value.components(separatedBy: ".")
+            guard let integer = Int(parts[0]) else { throw FormError.invalid }
+            var words = try cardinal(integer)
+            if parts.count > 1 { words = oblique(words) + " " + symbol("point") + " " + digits(parts[1], comma: false) }
+            return [sign, words].filter { !$0.isEmpty }.joined(separator: " ")
+        }
+        func amount(_ words: String, _ noun: String) -> String {
+            words == data.ones[1] ? data.count_one + " " + (data.singular[noun] ?? noun) : oblique(words) + " " + noun
+        }
+        func money(_ input: String, currency: String, scale: String?) throws -> String {
+            guard let key = symbols[currency] ?? data.currency_words[currency.lowercased()] ?? currencies[currency.lowercased()] else { throw FormError.invalid }
+            var value = try ungroup(input)
+            let sign = value.hasPrefix("-") ? symbol("minus") : value.hasPrefix("+") ? symbol("plus") : ""
+            value = value.trimmingCharacters(in: CharacterSet(charactersIn: "+-"))
+            let parts = value.components(separatedBy: "."), noun = symbol(key)
+            var words: String
+            if parts.count > 1, parts[1].count == 2, scale == nil {
+                guard let integer = Int(parts[0]), let fraction = Int(parts[1]) else { throw FormError.invalid }
+                words = amount(try cardinal(integer), noun)
+                if fraction > 0 { words += " " + amount(try cardinal(fraction), symbol(key == "rupee" ? "paisa" : "cent")) }
+            } else if let scale {
+                guard let scaleKey = data.scale_words[scale.lowercased()], let index = ["thousand": 0, "lakh": 1, "crore": 2][scaleKey] else { throw FormError.invalid }
+                let word = code == "te" && value == "1" ? (data.scale_one?[index][0] ?? data.scales[index][0]) : data.scales[index][0]
+                words = amount(amount(try number(value), word), noun)
+            } else { words = amount(try number(value), noun) }
+            return sign.isEmpty ? words : sign + " " + words
+        }
+        func date(day: Int, month: Int, year value: Int? = nil, monthFirst: Bool = false) throws -> String {
+            let year = value ?? 2000
+            guard (1...9999).contains(year), (1...12).contains(month), day >= 1 else { throw FormError.invalid }
+            let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
+            let days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
+            guard day <= days[month - 1] else { throw FormError.invalid }
+            let name = data.months[month - 1]
+            let words: String
+            if code == "ta", let dateDays = data.date_days { words = name + " " + dateDays[day] + " தேதி" }
+            else { words = monthFirst && code != "en" ? name + " " + (try cardinal(day)) : (try cardinal(day)) + " " + name }
+            return words + (try value.map { " " + (try self.year($0)) } ?? "")
+        }
+        func time(hour: Int, minute: Int, ampm: String?, sourcePeriod: String?) throws -> String {
+            guard hour <= 23, minute <= 59, ampm == nil || (1...12).contains(hour) else { throw FormError.invalid }
+            var period: String?
+            if let ampm, data.ampm.isEmpty, sourcePeriod == nil {
+                let h24 = hour % 12 + (ampm == "pm" ? 12 : 0)
+                period = (4..<12).contains(h24) ? "morning" : (12..<16).contains(h24) ? "afternoon" : (16..<20).contains(h24) ? "evening" : "night"
+            }
+            var words: String
+            if code == "te", (1...12).contains(hour) {
+                let h = hour == 1 ? "ఒక" : data.ones[hour]
+                let noun = hour == 1 ? "గంట" : minute == 0 ? "గంటలు" : "గంటల"
+                words = h + " " + noun + (minute == 1 ? " ఒక నిమిషం" : minute > 0 ? " " + data.ones[minute] + " నిమిషాలు" : "")
+            } else if code == "en" {
+                words = data.ones[hour] + (minute > 0 ? " " + data.ones[minute] : ampm != nil ? "" : " o'clock")
+                if hour == 0 { words = "zero " + (minute > 0 ? data.ones[minute] : "hundred") }
+            } else {
+                words = (minute > 0 ? data.time_hm : data.time_hour)
+                    .replacingOccurrences(of: "{h}", with: data.ones[hour]).replacingOccurrences(of: "{m}", with: data.ones[minute])
+            }
+            if let sourcePeriod { words = sourcePeriod + " " + words }
+            else if let period { words = (data.periods[period] ?? period) + " " + words }
+            if let ampm, let spoken = data.ampm[ampm] { words += " " + spoken }
+            return words
+        }
+    }
+
+    private static func uri(_ input: String, language: Language, tables: Tables) -> String {
+        let text = input.trimmingCharacters(in: CharacterSet(charactersIn: ".,;!?"))
+        let tail = String(input.suffix(input.utf16.count - text.utf16.count))
+        let address = substitute(#"^https?://"#, text) { _ in "" }
+        let symbols = ["@": "at", ".": "dot", "_": "underscore", "/": "slash", "+": "plus", "#": "hash"]
+        var parts: [String] = []
+        for token in matches(#"[^\W\d_]+|\d+|[^\w\s]|_"#, address).map(\.value) {
+            if token.allSatisfy({ $0.wholeNumberValue != nil }) { parts.append(language.digits(token, comma: false)) }
+            else if let key = symbols[token] { parts.append(language.symbol(key)) }
+            else if token == "-" { parts.append(language.data.dash) }
+            else if token.lowercased() == "www" || tables.uri_acronyms.contains(token.lowercased()) || token.count == 1 && token.unicodeScalars.allSatisfy({ $0.isASCII && CharacterSet.letters.contains($0) }) {
+                parts.append(token.uppercased().map { language.data.letters[String($0)] ?? String($0) }.joined(separator: " "))
+            } else { parts.append(token) }
+        }
+        return parts.joined(separator: " ") + tail
+    }
+
+    public static func normalize(_ input: String, language code: String = "en") throws -> String {
+        let tables = try tables.get()
+        guard let data = tables.languages[code] else { throw AudioGenerationError.invalidInput("Unsupported Maya-2 language: \(code)") }
+        let language = Language(code: code, data: data)
+        var months = tables.month_aliases.merging(data.month_aliases) { _, new in new }
+        for (i, name) in data.months.enumerated() { months[name.lowercased()] = i + 1 }
+        let currencyPattern = alternatives(Set(data.currency_words.keys).union(symbols.keys).union(["Rs", "Rs.", "INR"]))
+        let scales = alternatives(data.scale_words.keys), monthNames = alternatives(months.keys)
+        let markers = alternatives(data.time_markers), periods = alternatives(data.period_words.keys)
+        let patterns: [(String, String)] = [
+            ("tag", #"\[[^\[\]\n]*\]"#),
+            ("uri", #"[\w.+%-]+@[\w.-]+\.[A-Za-z]{2,}|(?:https?://|www\.)[^\s\[\]]+|(?<![\w.])[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}(?:/[^\s\[\]]*)?"#),
+            ("date", #"(?<![\w-])(?:\d{4}-\d{1,2}-\d{1,2}|\d{1,2}[/\.\-]\d{1,2}[/\.\-]\d{2,4})(?![\w/-])"#),
+            ("namedDate", #"(?<!\w)(?:\d{1,2}[ -](?:\#(monthNames))(?!\w)(?:[ ,\-]+\d{4})?|(?:\#(monthNames))\s+\d{1,2}(?:,?\s+\d{4})?)(?!\w)"#),
+            ("time", #"(?:(?<!\w)(?:\#(periods))\s+)?(?<![\w.])\d{1,2}(?::\d{2}|\.\d{2}(?=\s*[ap]\.?m\.?)|(?=\s*(?:[ap]\.?m\.?|\#(markers))(?!\w)))(?:\s*[ap]\.?m\.?)?(?:\s*(?:\#(markers))(?!\w))?(?:\s+(?:\#(periods))(?!\w))?(?!\d)"#),
+            ("money", #"(?<!\w)[+-]?(?:\#(currencyPattern))\s*[+-]?\#(numberPattern)(?:\s*(?:\#(scales))(?!\w))?|(?<!\w)[+-]?\#(numberPattern)\s+(?:\#(currencyPattern))(?!\w)"#),
+            ("percent", #"(?<!\w)-?\#(numberPattern)\s*%"#),
+            ("version", #"(?<!\w)v\d+(?:\.\d+){2,}(?!\w)"#),
+            ("identifier", #"(?<!\w)(?:\+\d{1,3}[ -]*)?(?:\d{4}(?:[ -]\d{4}){3}|\d{5}[ -]\d{5}|\d{3}[ -]\d{3}[ -]\d{4})(?!\d|[.,]\d)|(?<!\w)[A-Za-z]+[-\w]*\d[-\w]*(?!\w)|[#]\s*\d+"#),
+            ("number", #"(?<![\w.])[+-]?\#(numberPattern)(?![\w.]\d)"#)
+        ]
+        let regex = try NSRegularExpression(pattern: patterns.map { "(?<\($0.0)>\($0.1))" }.joined(separator: "|"), options: .caseInsensitive)
+        var text = substitute(#"\[[^\[\]\n]*\]|\d"#, input) { m in
+            m.value.hasPrefix("[") ? m.value : m.value.first?.wholeNumberValue.map(String.init) ?? m.value
+        }
+        text = substitute(#"\[[^\[\]\n]*\]|([\w\u0900-\u0dff]+)\s*:\s*(?=\d)"#, text) { m in
+            if let label = m.group(1), tables.id_words.contains(label.lowercased()) { return label + ", " }
+            return m.value
+        }
+        let source = text as NSString
+        var output = "", offset = 0
+        for result in regex.matches(in: text, range: NSRange(text.startIndex..., in: text)) {
+            let match = Match(text: text, result: result), token = match.value
+            let kind = patterns.first { result.range(withName: $0.0).location != NSNotFound }!.0
+            let replacement: String
+            do { replacement = try replace(token: token, kind: kind, match: match, language: language, tables: tables, months: months) }
+            catch { replacement = token }
+            output += source.substring(with: NSRange(location: offset, length: result.range.location - offset)) + replacement
+            offset = NSMaxRange(result.range)
+        }
+        output += source.substring(from: offset)
+        return substitute(#"\[[^\[\]\n]*\]|\s+"#, output) { $0.value.hasPrefix("[") ? $0.value : " " }.trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    private static func replace(token: String, kind: String, match: Match, language: Language, tables: Tables, months: [String: Int]) throws -> String {
+        switch kind {
+        case "tag": return token
+        case "uri": return uri(token, language: language, tables: tables)
+        case "date":
+            guard Set(matches(#"[/\.\-]"#, token).map(\.value)).count == 1 else { throw FormError.invalid }
+            let parts = token.components(separatedBy: CharacterSet(charactersIn: "/.-"))
+            guard parts.count == 3, let a = Int(parts[0]), let b = Int(parts[1]), let c = Int(parts[2]) else { throw FormError.invalid }
+            var (year, month, day) = parts[0].count == 4 ? (a, b, c) : (c, b, a)
+            if parts[0].count != 4 && parts[2].count == 2 { year += year <= 50 ? 2000 : 1900 }
+            return try language.date(day: day, month: month, year: year)
+        case "namedDate":
+            let dayFirst = matches(#"^(\d{1,2})[ -](.+?)(?:[ ,\-]+(\d{4}))?$"#, token).first
+            let m = dayFirst ?? matches(#"^(.+?)\s+(\d{1,2})(?:,?\s+(\d{4}))?$"#, token).first
+            guard let m, let day = Int(m.group(dayFirst == nil ? 2 : 1) ?? ""),
+                  let month = months[(m.group(dayFirst == nil ? 1 : 2) ?? "").lowercased()] else { throw FormError.invalid }
+            return try language.date(day: day, month: month, year: m.group(3).flatMap(Int.init), monthFirst: dayFirst == nil)
+        case "time":
+            guard let h = matches(#"(\d{1,2})(?:[.:](\d{2}))?"#, token).first, let hour = Int(h.group(1) ?? "") else { throw FormError.invalid }
+            let ampm = matches(#"([ap])\.?m\.?"#, token).first?.group(1).map { $0.lowercased() + "m" }
+            let period = matches(#"(?<!\w)(\#(alternatives(language.data.period_words.keys)))(?!\w)"#, token).first?.value
+            let words = try language.time(hour: hour, minute: h.group(2).flatMap(Int.init) ?? 0, ampm: ampm, sourcePeriod: period)
+            for (marker, endings) in language.data.time_marker_endings where !matches(NSRegularExpression.escapedPattern(for: marker) + #"(?!\w)"#, token).isEmpty {
+                if let space = words.lastIndex(of: " ") {
+                    let last = String(words[words.index(after: space)...])
+                    return String(words[...space]) + (endings[last] ?? last)
+                }
+            }
+            return words
+        case "money":
+            guard let n = matches(numberPattern, token).first else { throw FormError.invalid }
+            let ns = token as NSString
+            let before = ns.substring(to: n.result.range.location).trimmingCharacters(in: .whitespaces)
+            let after = ns.substring(from: NSMaxRange(n.result.range)).trimmingCharacters(in: .whitespaces)
+            let currency = before.trimmingCharacters(in: CharacterSet(charactersIn: "+- "))
+            let value = (before.contains("-") ? "-" : before.contains("+") ? "+" : "") + n.value
+            if currency.isEmpty { return try language.number(value) + " " + after }
+            return try language.money(value, currency: currency, scale: after.isEmpty ? nil : after)
+        case "percent": return try language.number(String(token.dropLast()).trimmingCharacters(in: .whitespaces)) + " " + language.symbol("percent")
+        case "version":
+            let parts = try token.dropFirst().components(separatedBy: ".").map { value -> String in
+                guard let n = Int(value) else { throw FormError.invalid }; return try language.cardinal(n)
+            }
+            return (language.data.letters["V"] ?? "V") + " " + parts.joined(separator: " " + language.symbol("point") + " ")
+        case "identifier":
+            var words: [String] = []
+            for char in token {
+                if let digit = char.wholeNumberValue { words.append(language.data.ones[digit]) }
+                else if char.unicodeScalars.allSatisfy({ $0.isASCII && CharacterSet.letters.contains($0) }) {
+                    words.append(language.data.letters[String(char).uppercased()] ?? String(char))
+                }
+            }
+            let separator = token.contains("-") && token.unicodeScalars.contains(where: { CharacterSet.letters.contains($0) }) ? " " : ", "
+            return (token.hasPrefix("+") ? language.symbol("plus") + " " : "") + words.joined(separator: separator)
+        default:
+            let digits = token.replacingOccurrences(of: ",", with: "").trimmingCharacters(in: CharacterSet(charactersIn: "+-"))
+            if !digits.contains(".") && !token.contains(",") {
+                let ns = match.text as NSString
+                let beforeStart = max(0, match.result.range.location - 70)
+                let before = ns.substring(with: NSRange(location: beforeStart, length: match.result.range.location - beforeStart)).lowercased()
+                let afterStart = NSMaxRange(match.result.range)
+                let after = ns.substring(with: NSRange(location: afterStart, length: min(50, ns.length - afterStart))).lowercased()
+                let beforeTail = before.components(separatedBy: CharacterSet(charactersIn: ".!?;।॥\n")).last ?? ""
+                let afterHead = after.components(separatedBy: CharacterSet(charactersIn: ".!?;।॥\n")).first ?? ""
+                let context = Set(matches(#"[\w\u0900-\u0dff]+"#, beforeTail).suffix(3).map(\.value) + matches(#"[\w\u0900-\u0dff]+"#, afterHead).prefix(4).map(\.value))
+                let identifier = !context.isDisjoint(with: tables.id_words) && context.isDisjoint(with: tables.label_words + language.data.year_words)
+                if digits.hasPrefix("0") && digits.count > 1 || digits.count >= 7 || identifier && digits.count >= 3 {
+                    let sign = token.hasPrefix("-") ? language.symbol("minus") + " " : token.hasPrefix("+") ? language.symbol("plus") + " " : ""
+                    return sign + language.digits(digits)
+                }
+            }
+            return try language.number(token)
+        }
+    }
+}
