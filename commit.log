+            maxConditioningInputs: try c.decodeIfPresent(Int.self, forKey: .maxConditioningInputs) ?? 1,
+            conditionNumLatent: try c.decodeIfPresent(Int.self, forKey: .conditionNumLatent) ?? 32
+        )
