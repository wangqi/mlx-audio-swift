+        try FileManager.default.createDirectory(at: refsDir, withIntermediateDirectories: true)
+
+        let tokenizerURL = snapshotDir.appendingPathComponent("tokenizer.model")
+        try Data([0x49, 0x54, 0x53]).write(to: tokenizerURL)
