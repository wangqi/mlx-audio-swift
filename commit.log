-+        output = MLX.clip(output, min: -audioLimit, max: audioLimit)
-+        return output
-+    }
-+
-+    func callAsFunction(_ speechFeat: MLXArray, cacheSource: MLXArray? = nil)
-+        -> (MLXArray, MLXArray)
-+    {
