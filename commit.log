-+    }
-+
-+    func callAsFunction(_ x: MLXArray) -> MLXArray {
-+        x * scale
-+    }
-+}
-+
-+private final class MossAudioIdentity: Module {}
-+
-+private func mossApplyLayerScale(_ module: Module, to x: MLXArray) -> MLXArray {
-+    if let scale = module as? MossLayerScale {
-+        return scale(x)
-+    }
-+    return x
-+}
