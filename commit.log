+        defer { try? FileManager.default.removeItem(at: dir) }
+
+        let tokens = """
+        <|startofcontext|> 10
+        <|startoftranscript|> 11
+        <|emo:undefined|> 12
+        <|en|> 13
+        <|de|> 14
