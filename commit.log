++    if !word.allSatisfy({ ch in
++      if let v = ch.unicodeScalars.first?.value {
++        return Lexicon.lexiconOrdinals.contains(Int(v))
++      }
++      return false
++    }) {
++      return false
++    }
++    
++    if word.count == 1 { return true }
++    if word == word.uppercased(), golds[word.lowercased()] != nil { return true }
