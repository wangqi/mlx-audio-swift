index 0000000..50d237a
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Zonos3/README.md
@@ -0,0 +1,69 @@
+# ZONOS3-Mini
+
+Native Swift port of [Zyphra's ZONOS3-Mini](https://huggingface.co/Zyphra/ZONOS3-Mini),
+using [mlx-community/ZONOS3-Mini](https://huggingface.co/mlx-community/ZONOS3-Mini)
+directly. No model conversion is needed.
+
+Supports 44.1 kHz mono synthesis, 27 built-in voices, incremental streaming,
+reference-audio voice cloning without a transcript, speaker embeddings and
+guidance, speed, and acoustic conditions.
+
+```swift
+import MLXAudioCore
+import MLXAudioTTS
+
+let model = try await Zonos3Model.fromPretrained("mlx-community/ZONOS3-Mini")
+let audio = try await model.generate(text: "Hello from Swift!", voice: "jett")
+print(model.voices)
+
+for try await event in model.generateStream(text: "Welcome back.", voice: "imogen") {
+    if case .audio(let chunk) = event {
+        // Play or accumulate chunk. Concatenate chunks for the complete waveform.
+        print(chunk.size)
+    }
+}
+```
+
+The same repository ID works with `TTS.loadModel(modelRepo:)` and the TTS CLI:
+
+```bash
+mlx-audio-swift-tts --model mlx-community/ZONOS3-Mini \
+  --text "Hello from ZONOS3 Mini!" --voice jett
+```
+
+Pass `refAudio:` as a materialized, finite mono waveform at **44,100 Hz** to
+clone a voice. Reference audio is capped at 60 seconds. Use `voice: "none"`
+for synthesis without a speaker prompt. `extractSpeakerEmbedding(_:)` returns
+a reusable 192-dimensional vector accepted by `speakerEmbedding:`. Reference
+audio and an explicit embedding are mutually exclusive.
+
+`Zonos3Options` exposes `speed`, `speakerCFGScale`, `conditionValues` (for
+`loudness`, `fmax`, and `speaking_rate`) or `conditionBuckets`,
+`silencePrefillFrames`, `minFrames`, `repetitionCodebooks`, `headroomDB`, and
+`textNormalization`. Speed cannot be combined with explicit conditions.
+English number normalization is enabled by default. Token budgets count
+delayed audio rows at 15 Hz. Serialize generation calls on each instance.
+
+Speech editing, accent adapters, hidden-state steering, and raw reference-code
+encoding follow the Python port's scope and are not exposed.
+
+## Validation
+
+Run the focused tests with Xcode to build and bundle the Metal library:
+
+```bash
+xcodebuild -scheme MLXAudio-Package -destination 'platform=macOS' \
+  -only-testing:MLXAudioTests/Zonos3Tests test
+```
+
+Tests use synthetic Python/NumPy reference values and do not download weights.
+To enable synthesis, streaming, and cloning checks against a downloaded snapshot,
+set `TEST_RUNNER_MLXAUDIO_ZONOS3_MODEL_DIR` to its directory when invoking
+`xcodebuild`. CPU fixtures use strict FP32 tolerances; the optional full-checkpoint
+comparisons allow the small differences between Metal matrix kernels.
+
+Model weights: [Apache 2.0](https://www.apache.org/licenses/LICENSE-2.0).
+Backbone, codec, and speaker encoder: adapted from
+[Zyphra's MIT-licensed runtime](https://github.com/Zyphra/ZONOS3-Mini/blob/6ff97cac0c684732de5f2bc6e3671aa783c15054/LICENSE).
+The Gated DeltaNet kernel includes
+[Apple's MIT-licensed mlx-lm code](https://github.com/ml-explore/mlx-lm/blob/main/LICENSE).
diff --git a/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Backbone.swift b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Backbone.swift
new file mode 100644
index 0000000..4f88c93
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Backbone.swift
@@ -0,0 +1,201 @@
+// Copyright (c) 2026 Zyphra, Inc. Adapted under the MIT License.
+import Foundation
+import MLX
+import MLXFast
+import MLXNN
+
+final class Zonos3LMState {
+    var position = 0
+    var kv: [Int: (MLXArray, MLXArray)] = [:]
+    var recurrent: [Int: MLXArray] = [:]
+    var convolution: [Int: MLXArray] = [:]
+    var arrays: [MLXArray] {
+        kv.values.flatMap { [$0.0, $0.1] } + Array(recurrent.values) + Array(convolution.values)
+    }
+}
+
+func zonos3RMS(_ x: MLXArray, _ weight: MLXArray? = nil, _ eps: Float) -> MLXArray {
+    MLXFast.rmsNorm(x, weight: weight ?? .ones([x.dim(-1)]), eps: eps)
+}
+
+final class Zonos3Backbone {
+    let config: Zonos3BackboneConfiguration
+    let p: Zonos3TensorStore
+    init(_ config: Zonos3BackboneConfiguration, params: Zonos3TensorStore) {
+        self.config = config
+        self.p = params
+    }
+
+    private func attention(_ x: MLXArray, layer: Int, state: Zonos3LMState) -> MLXArray {
+        let c = config
+        let prefix = "blk.\(layer)."
+        let n = x.dim(0)
+        let lo = state.position
+        let need = lo + x.dim(0)
+        func lin(_ name: String) -> MLXArray { p.lin(prefix + name + ".weight", x) }
+        let gate = sigmoid(lin("attn_gate"))
+        var q = lin("attn_q").reshaped(n, c.nHeads, c.headDim)
+        var k = lin("attn_k").reshaped(n, c.nKvHeads, c.headDim)
+        let v = lin("attn_v").reshaped(n, c.nKvHeads, c.headDim).transposed(1, 0, 2)
+        q = zonos3RMS(q, nil, c.qkEps) * p.t(prefix + "attn_temp")[0..., .newAxis]
+        k = zonos3RMS(k, nil, c.qkEps)
+        q = MLXFast.RoPE(
+            q.transposed(1, 0, 2), dimensions: c.headDim,
+            traditional: true, base: c.ropeTheta, scale: 1, offset: lo)
+        k = MLXFast.RoPE(
+            k.transposed(1, 0, 2), dimensions: c.headDim,
+            traditional: true, base: c.ropeTheta, scale: 1, offset: lo)
+        var kc: MLXArray
+        var vc: MLXArray
+        if let old = state.kv[layer] {
+            (kc, vc) = old
+        } else {
+            kc = .zeros([c.nKvHeads, 0, c.headDim])
+            vc = .zeros(kc.shape)
+        }
+        if kc.dim(1) < need {
+            let pad = MLXArray.zeros([
+                c.nKvHeads, ((need + 255) / 256) * 256 - kc.dim(1), c.headDim,
+            ])
+            kc = concatenated([kc, pad], axis: 1)
+            vc = concatenated([vc, pad], axis: 1)
+        }
+        // MLXArray is a reference type: copy wrappers before in-place indexing cached arrays.
+        kc = kc.reshaped(kc.shape)
+        vc = vc.reshaped(vc.shape)
+        kc[0..., lo ..< need, 0...] = k
+        vc[0..., lo ..< need, 0...] = v
+        state.kv[layer] = (kc, vc)
+        let mask: MLXFast.ScaledDotProductAttentionMaskMode =
+            n > 1
+            ? .array(
+                MLXArray(0 ..< need)[.newAxis, 0...] .<= (lo + MLXArray(0 ..< n))[0..., .newAxis])
+            : .none
+        var out = MLXFast.scaledDotProductAttention(
+            queries: q[.newAxis],
+            keys: kc[.newAxis, 0..., 0 ..< need, 0...],
+            values: vc[.newAxis, 0..., 0 ..< need, 0...],
+            scale: pow(Float(c.headDim), -0.5), mask: mask)[0]
+        out = out.transposed(1, 0, 2) * gate[0..., 0..., .newAxis]
+        return p.lin(prefix + "attn_output.weight", out.reshaped(n, -1))
+    }
+
+    private func gdn(_ x: MLXArray, layer: Int, state: Zonos3LMState) -> MLXArray {
+        let c = config
+        let prefix = "blk.\(layer)."
+        let n = x.dim(0)
+        let h = c.gdnHeads
+        let d = c.gdnHeadDim
+        let inner = h * d
+        let kernel = c.gdnKernel
+        let projection = p.lin(prefix + "gdn_in.weight", x)
+        let qkv = projection[0..., 0 ..< (3 * inner)]
+        let z = projection[0..., (3 * inner) ..< (4 * inner)].reshaped(n, h, d)
+        let a = projection[0..., (4 * inner) ..< (4 * inner + h)]
+        let b = projection[0..., (4 * inner + h) ..< (4 * inner + 2 * h)]
+        let history = state.convolution[layer] ?? .zeros([3 * inner, kernel - 1])
+        let sequence = concatenated([history.T, qkv])
+        let w = p.t(prefix + "gdn_conv.weight")
+        var conv = sequence[0 ..< n] * w[0..., 0]
+        for j in 1 ..< kernel { conv = conv + sequence[j ..< (j + n)] * w[0..., j] }
+        conv = silu(conv)
+        state.convolution[layer] = sequence[(sequence.dim(0) - kernel + 1)...].T
+        var q = conv[0..., 0 ..< inner].reshaped(n, h, d)
+        var k = conv[0..., inner ..< (2 * inner)].reshaped(n, h, d)
+        let v = conv[0..., (2 * inner)...].reshaped(n, h, d)
+        q = q * rsqrt((q * q).sum(axis: -1, keepDims: true) + 1e-6)
+        k = k * rsqrt((k * k).sum(axis: -1, keepDims: true) + 1e-6)
+        let decay = exp(
+            -exp(p.t(prefix + "gdn_A_log"))
+                * logAddExp(a + p.t(prefix + "gdn_dt_bias"), MLXArray(0)))
+        let initial = state.recurrent[layer] ?? .zeros([1, h, d, d])
+        let (y, final) = Zonos3DeltaKernel.callAsFunction(
+            q: (q * pow(Float(d), -0.5))[.newAxis], k: k[.newAxis],
+            v: v[.newAxis], decay: decay[.newAxis], beta: sigmoid(b)[.newAxis], state: initial)
+        state.recurrent[layer] = final
+        let normalized = zonos3RMS(y[0], p.t(prefix + "gdn_norm.weight"), 1e-5)
+        return p.lin(prefix + "attn_output.weight", (normalized * silu(z)).reshaped(n, inner))
+    }
+
+    private func feedForward(_ x: MLXArray, layer: Int) -> MLXArray {
+        let c = config
+        let prefix = "blk.\(layer)."
+        func lin(_ name: String, _ input: MLXArray) -> MLXArray {
+            p.lin(prefix + name + ".weight", input)
+        }
+        if p.matrices[prefix + "ffn_up.weight"] != nil {
+            return lin("ffn_down", lin("ffn_up", x) * silu(lin("ffn_gate", x)))
+        }
+        let logits = lin("router", zonos3RMS(x, p.t(prefix + "router_norm.weight"), c.normEps))
+        let choices = argPartition(
+            p.t(prefix + "router_bias") - logits, kth: c.moeTopk - 1, axis: -1)[
+                0..., 0 ..< c.moeTopk]
+        let weights = softmax(takeAlong(logits, choices, axis: -1), axis: -1)
+        let latent = lin("ffn_latent_down", x)[0..., .newAxis, .newAxis, 0...]
+        let gate = p.matrices[prefix + "ffn_gate_exps.weight"]!(latent, indices: choices)
+        let up = p.matrices[prefix + "ffn_up_exps.weight"]!(latent, indices: choices)
+        let down = p.matrices[prefix + "ffn_down_exps.weight"]!(silu(gate) * up, indices: choices)
+        return lin(
+            "ffn_latent_up",
+            (down[0..., 0..., 0, 0...] * weights[0..., 0..., .newAxis]).sum(axis: 1))
+    }
+
+    func callAsFunction(
+        _ ids: MLXArray, state: Zonos3LMState,
+        speaker: MLXArray? = nil, conditions: [Int]? = nil
+    ) throws -> MLXArray {
+        let c = config
+        let lo = state.position
+        guard ids.ndim == 2, ids.dim(0) > 0, ids.dim(1) == c.nCodebooks + 1,
+            ids.dim(0) <= c.maxSeqlen - lo
+        else {
+            throw Zonos3Error.invalidInput("Invalid prompt shape or context exceeded")
+        }
+        let n = ids.dim(0)
+        var x = p.t("audio_embd.0.weight")[ids[0..., 0]]
+        for cb in 1 ..< c.nCodebooks { x = x + p.t("audio_embd.\(cb).weight")[ids[0..., cb]] }
+        x = x + p.t("text_embd.weight")[ids[0..., c.nCodebooks]]
+        if lo == 0 {
+            if let speaker {
+                x[0] =
+                    p.lin("speaker_proj.weight", speaker.reshaped(1, -1))[0]
+                    + p.t("speaker_proj.bias")
+            }
+            let offset = speaker == nil ? 0 : 1
+            if let conditions {
+                for (i, bucket) in conditions.enumerated() {
+                    x[offset + i] = p.t("cond_embd.\(i).weight")[bucket]
+                }
+            }
+        }
+        x = zonos3RMS(x, nil, c.normEps)
+        let queries = p.t("attnres_q.weight")
+        var bank: [MLXArray] = []
+        var scores: [MLXArray] = []
+        func route(_ source: MLXArray, _ query: Int) -> MLXArray {
+            bank.append(source)
+            scores.append(matmul(zonos3RMS(source, nil, c.normEps), queries.T))
+            if bank.count == 1 { return source }
+            let w = softmax(stacked(scores.map { $0[0..., query] }), axis: 0)
+            return (stacked(bank) * w[0..., 0..., .newAxis]).sum(axis: 0)
+        }
+        var mixed = route(x, 0)
+        for layer in 0 ..< c.nLayers {
+            let prefix = "blk.\(layer)."
+            if layer > 0 { mixed = route(x, 2 * layer) }
+            let input = zonos3RMS(mixed, p.t(prefix + "attn_norm.weight"), c.normEps)
+            let out =
+                (layer + 1) % c.gdnPeriod != 0
+                ? gdn(input, layer: layer, state: state)
+                : attention(input, layer: layer, state: state)
+            mixed = route(out, 2 * layer + 1)
+            x = feedForward(
+                zonos3RMS(mixed, p.t(prefix + "ffn_norm.weight"), c.normEps), layer: layer)
+        }
+        mixed = route(x, 2 * c.nLayers)
+        let logits = p.lin("output.weight", zonos3RMS(mixed, p.t("output_norm.weight"), c.normEps))
+            .reshaped(n, c.nCodebooks, c.audioVocab)
+        state.position = lo + n
+        return c.lossSoftcap * tanh(logits / c.lossSoftcap)
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Codec.swift b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Codec.swift
new file mode 100644
index 0000000..9382976
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Codec.swift
@@ -0,0 +1,384 @@
+// Copyright (c) 2026 Zyphra, Inc. Adapted under the MIT License.
+import Foundation
+import MLX
+import MLXFFT
+import MLXFast
+import MLXNN
+
+func zonos3LayerNorm(_ x: MLXArray, _ p: Zonos3TensorStore, _ prefix: String, _ eps: Float)
+    -> MLXArray
+{
+    MLXFast.layerNorm(x, weight: p.t(prefix + ".weight"), bias: p.t(prefix + ".bias"), eps: eps)
+}
+
+/// Causal ZAC: semantic/residual RVQ, MOSS transformers, ConvNeXt, dual iSTFT, sinc resampling.
+final class Zonos3Codec {
+    struct Stage {
+        let outDim: Int, heads: Int, layers: Int, context: Int, patch: Int
+    }
+    let p: Zonos3TensorStore
+    let hop: Int, internalHop: Int, codebooks: Int, codebookSize: Int
+    let semDepth: Int, headDepth: Int, headHop: Int, nFFT: [Int]
+    let maxLogMagnitude: Float, headroomDB: Float, lnEps: Float, convEps: Float
+    let resampleOrig: Int, resampleNew: Int, resampleWidth: Int
+    let stages: [Stage]
+
+    init(_ directory: URL) throws {
+        let file = try Zonos3Component(directory, architecture: "mossdual_istft")
+        p = file.params
+        func value<T>(_ key: String, _: T.Type = T.self) throws -> T {
+            guard let value = file.metadata["mossdual_istft." + key] as? T else {
+                throw Zonos3Error.invalidCheckpoint("Missing codec metadata: \(key)")
+            }
+            return value
+        }
+        hop = try value("hop")
+        internalHop = try value("internal_hop")
+        codebooks = try value("n_codebooks")
+        codebookSize = try value("codebook_size")
+        semDepth = try value("sem_head.depth")
+        headDepth = try value("head.depth")
+        headHop = try value("head.hop")
+        nFFT = try value("head.n_fft")
+        maxLogMagnitude = Float(try value("head.max_log_magnitude", Double.self))
+        headroomDB = Float(try value("headroom_db", Double.self))
+        lnEps = Float(try value("ln_eps", Double.self))
+        convEps = Float(try value("convnext_eps", Double.self))
+        resampleOrig = try value("resample.orig")
+        resampleNew = try value("resample.new")
+        resampleWidth = try value("resample.width")
+        let outs: [Int] = try value("stage.out_dim")
+        let heads: [Int] = try value("stage.n_head")
+        let layers: [Int] = try value("stage.n_layer")
+        let contexts: [Int] = try value("stage.context")
+        let patches: [Int] = try value("stage.patch")
+        guard try value("sample_rate", Int.self) == 44100, hop == 2940, internalHop == 2944,
+            codebooks == 10, codebookSize == 4096, nFFT == [736, 2208], headHop == 184,
+            resampleOrig == 736, resampleNew == 735, resampleWidth == 17,
+            !outs.isEmpty,
+            [heads.count, layers.count, contexts.count, patches.count].allSatisfy({
+                $0 == outs.count
+            })
+        else { throw Zonos3Error.invalidCheckpoint("Inconsistent ZAC decoder dimensions") }
+        stages = outs.indices.map {
+            Stage(
+                outDim: outs[$0], heads: heads[$0], layers: layers[$0], context: contexts[$0],
+                patch: patches[$0])
+        }
+        eval(p.arrays)
+    }
+
+    func gain(_ db: Float?) -> Float { pow(10, -(db ?? headroomDB) / 20) }
+
+    static func patchUp(_ x: MLXArray, _ patch: Int) -> MLXArray {
+        x.reshaped(x.dim(0), x.dim(1) / patch, patch).transposed(0, 2, 1).reshaped(
+            -1, x.dim(1) / patch)
+    }
+
+    func convnext(_ x: MLXArray, prefix: String, history: MLXArray?) -> (MLXArray, MLXArray) {
+        let w = p.t(prefix + ".dw.weight")
+        let n = x.dim(0)
+        let k = w.dim(1)
+        let sequence = concatenated([history ?? .zeros([k - 1, x.dim(1)]), x])
+        var h = sequence[0 ..< n] * w[0..., 0]
+        for j in 1 ..< k { h = h + sequence[j ..< (j + n)] * w[0..., j] }
+        h = h + p.t(prefix + ".dw.bias")
+        h = zonos3LayerNorm(h, p, prefix + ".norm", convEps)
+        h = gelu(p.lin(prefix + ".pw1.weight", h, bias: prefix + ".pw1.bias"))
+        h = p.lin(prefix + ".pw2.weight", h, bias: prefix + ".pw2.bias")
+        return (x + h, sequence[(sequence.dim(0) - k + 1)...])
+    }
+
+    func moss(
+        _ input: MLXArray, prefix: String, stage: Stage, position: Int,
+        cache: (MLXArray, MLXArray)?
+    ) -> (MLXArray, (MLXArray, MLXArray)?) {
+        let n = input.dim(0)
+        let d = input.dim(1)
+        let hd = d / stage.heads
+        var h = zonos3LayerNorm(input, p, prefix + ".norm1", lnEps)
+        let qkv = p.lin(prefix + ".qkv.weight", h).reshaped(n, 3, stage.heads, hd).transposed(
+            1, 2, 0, 3)
+        let q = MLXFast.RoPE(
+            qkv[0], dimensions: hd, traditional: true, base: 10000, scale: 1, offset: position)
+        var k = MLXFast.RoPE(
+            qkv[1], dimensions: hd, traditional: true, base: 10000, scale: 1, offset: position)
+        var v = qkv[2]
+        if let cache {
+            k = concatenated([cache.0, k], axis: 1)
+            v = concatenated([cache.1, v], axis: 1)
+        }
+        let lc = k.dim(1) - n
+        // Bound temporary attention matrices for long nonstreaming utterances as well.
+        var pieces: [MLXArray] = []
+        for start in stride(from: 0, to: n, by: 512) {
+            let end = min(n, start + 512)
+            let left = max(0, lc + start - stage.context + 1)
+            let diff =
+                MLXArray(position + start ..< position + end)[0..., .newAxis]
+                - MLXArray(position - lc + left ..< position + end)[.newAxis, 0...]
+            let mask = (diff .>= 0) .&& (diff .< stage.context)
+            pieces.append(
+                MLXFast.scaledDotProductAttention(
+                    queries: q[.newAxis, 0..., start ..< end, 0...],
+                    keys: k[.newAxis, 0..., left ..< (lc + end), 0...],
+                    values: v[.newAxis, 0..., left ..< (lc + end), 0...],
+                    scale: pow(Float(hd), -0.5), mask: .array(mask))[0])
+        }
+        let o = concatenated(pieces, axis: 1).transposed(1, 0, 2).reshaped(n, d)
+        let x = input + p.lin(prefix + ".wo.weight", o) * p.t(prefix + ".attn_scale")
+        h = zonos3LayerNorm(x, p, prefix + ".norm2", lnEps)
+        h = p.lin(prefix + ".ffn2.weight", gelu(p.lin(prefix + ".ffn1.weight", h)))
+        let keep = min(stage.context - 1, k.dim(1))
+        let next: (MLXArray, MLXArray)? =
+            keep > 0
+            ? (k[0..., (k.dim(1) - keep)...], v[0..., (v.dim(1) - keep)...]) : nil
+        return (x + h * p.t(prefix + ".ffn_scale"), next)
+    }
+
+    func decode(_ codes: MLXArray) throws -> MLXArray {
+        let stream = Zonos3CodecStream(self)
+        let audio = try stream.decode(codes)
+        let tail = stream.flush()
+        return concatenated([audio, tail])
+    }
+}
+
+final class Zonos3CodecStream {
+    let decoder: Zonos3Codec
+    var frames = 0
+    var semHistory: [MLXArray?], headHistory: [MLXArray?]
+    var kv: [[(MLXArray, MLXArray)?]]
+    let head: Zonos3ISTFTStream
+    let resampler: Zonos3ResamplerStream
+
+    init(_ decoder: Zonos3Codec) {
+        self.decoder = decoder
+        semHistory = Array(repeating: nil, count: decoder.semDepth)
+        headHistory = Array(repeating: nil, count: decoder.headDepth)
+        kv = decoder.stages.map { Array(repeating: nil, count: $0.layers) }
+        head = Zonos3ISTFTStream(
+            nFFT: decoder.nFFT, hop: decoder.headHop,
+            windows: (0 ..< 2).map { decoder.p.t("head.window.\($0)") },
+            mixer: decoder.p.t("head.mixer.weight"), maxLogMagnitude: decoder.maxLogMagnitude)
+        resampler = Zonos3ResamplerStream(
+            kernel: decoder.p.t("resample.kernel"),
+            orig: decoder.resampleOrig, new: decoder.resampleNew, width: decoder.resampleWidth)
+    }
+
+    func decode(_ codes: MLXArray) throws -> MLXArray {
+        let d = decoder
+        guard codes.ndim == 2, codes.dim(1) == d.codebooks else {
+            throw Zonos3Error.invalidInput("Codes must be [frames, \(d.codebooks)]")
+        }
+        if codes.dim(0) == 0 { return .zeros([0]) }
+        guard !MLX.any((codes .< 0) .|| (codes .>= d.codebookSize)).item(Bool.self) else {
+            throw Zonos3Error.invalidInput("Codes contain non-codec tokens")
+        }
+        var chunks: [MLXArray] = []
+        for start in stride(from: 0, to: codes.dim(0), by: 32) {
+            try Task.checkCancellation()
+            chunks.append(chunk(codes[start ..< min(start + 32, codes.dim(0))].asType(.int32)))
+        }
+        return concatenated(chunks)
+    }
+
+    private func chunk(_ ids: MLXArray) -> MLXArray {
+        let d = decoder
+        let p = d.p
+        var x = p.t("sem.table")[ids[0..., 0]] + p.t("sem.bias")
+        for b in 0 ..< d.semDepth {
+            (x, semHistory[b]) = d.convnext(x, prefix: "sem_head.\(b)", history: semHistory[b])
+        }
+        x = p.lin("sem_head.out.weight", x, bias: "sem_head.out.bias")
+        for cb in 1 ..< d.codebooks { x = x + p.t("res.\(cb - 1).table")[ids[0..., cb]] }
+        x = x + p.t("res.bias")
+        eval(x)
+        var positionsPerFrame = 1
+        for (s, hp) in d.stages.enumerated() {
+            let prefix = "stage.\(s)"
+            x = p.lin(prefix + ".in.weight", x)
+            for layer in 0 ..< hp.layers {
+                (x, kv[s][layer]) = d.moss(
+                    x, prefix: prefix + ".l\(layer)", stage: hp,
+                    position: frames * positionsPerFrame, cache: kv[s][layer])
+                eval([x] + (kv[s][layer].map { [$0.0, $0.1] } ?? []))
+            }
+            if hp.outDim > 0 { x = p.lin(prefix + ".out.weight", x) }
+            if hp.patch > 1 {
+                x = Zonos3Codec.patchUp(x, hp.patch)
+                positionsPerFrame *= hp.patch
+            }
+        }
+        for b in 0 ..< d.headDepth {
+            (x, headHistory[b]) = d.convnext(x, prefix: "head.\(b)", history: headHistory[b])
+            eval(x)
+        }
+        x = zonos3LayerNorm(x, p, "head.norm", d.convEps)
+        let y0 = p.lin("head.out.0.weight", x, bias: "head.out.0.bias")
+        let y1 = p.lin("head.out.1.weight", x, bias: "head.out.1.bias")
+        eval([y0, y1] + (semHistory + headHistory).compactMap { $0 })
+        let out = resampler.push(head.push([y0, y1]))
+        eval([out, resampler.buffer] + head.ola + head.envelope + head.mixInput)
+        frames += ids.dim(0)
+        return out
+    }
+
+    func flush() -> MLXArray {
+        let out = concatenated([resampler.push(head.flush()), resampler.flush()])
+        eval(out)
+        return out
+    }
+}
+
+/// Finalize only samples no future iSTFT frame or FIR tap can change.
+final class Zonos3ISTFTStream {
+    let nFFT: [Int], hop: Int, windows: [MLXArray], mixer: MLXArray, maxLogMagnitude: Float
+    let half: Int
+    var ola = [MLXArray.zeros([0]), MLXArray.zeros([0])]
+    var envelope = [MLXArray.zeros([0]), MLXArray.zeros([0])]
+    var base = [0, 0]
+    var mixInput: [MLXArray]
+    var frames = 0
+    var mixBase = 0
+    var done = false
+
+    init(nFFT: [Int], hop: Int, windows: [MLXArray], mixer: MLXArray, maxLogMagnitude: Float) {
+        self.nFFT = nFFT
+        self.hop = hop
+        self.windows = windows
+        self.mixer = mixer
+        self.maxLogMagnitude = maxLogMagnitude
+        half = (mixer.dim(1) - 1) / 2
+        mixInput = [.zeros([half]), .zeros([half])]
+    }
+
+    func push(_ spectra: [MLXArray]) -> MLXArray {
+        precondition(!done)
+        let cols = spectra[0].dim(0)
+        if cols == 0 { return .zeros([0]) }
+        for i in 0 ..< 2 {
+            let n = nFFT[i]
+            let bins = n / 2 + 1
+            let r = n / hop
+            let spec = spectra[i]
+            let mag = exp(minimum(spec[0..., 0 ..< bins], maxLogMagnitude))
+            let phase = spec[0..., bins ..< (2 * bins)]
+            let edge = ((MLXArray(0 ..< bins) .> 0) .&& (MLXArray(0 ..< bins) .< bins - 1)).asType(
+                .float32)
+            let complex =
+                mag * cos(phase) + MLXArray(real: Float(0), imaginary: Float(1)) * mag * sin(phase)
+                * edge
+            let inverse = MLXFFT.irfft(complex, n: n) * windows[i]
+            let parts = inverse.reshaped(cols, r, hop)
+            let win2 = (windows[i] * windows[i]).reshaped(r, hop)
+            let add = MLXArray.zeros([cols + r - 1, hop])
+            let env = MLXArray.zeros([cols + r - 1, hop])
+            for j in 0 ..< r {
+                add[j ..< (j + cols)] = add[j ..< (j + cols)] + parts[0..., j]
+                env[j ..< (j + cols)] = env[j ..< (j + cols)] + win2[j]
+            }
+            let offset = frames * hop - base[i]
+            let need = offset + add.size
+            if ola[i].size < need {
+                let zeros = MLXArray.zeros([need - ola[i].size])
+                ola[i] = concatenated([ola[i], zeros])
+                envelope[i] = concatenated([envelope[i], zeros])
+            }
+            // Never mutate a wrapper shared with another buffer.
+            let current = ola[i].reshaped(-1)
+            let currentEnv = envelope[i].reshaped(-1)
+            current[offset ..< need] = current[offset ..< need] + add.reshaped(-1)
+            currentEnv[offset ..< need] = currentEnv[offset ..< need] + env.reshaped(-1)
+            ola[i] = current
+            envelope[i] = currentEnv
+        }
+        frames += cols
+        for i in 0 ..< 2 { finalize(i, through: frames * hop) }
+        return emit()
+    }
+
+    private func finalize(_ i: Int, through position: Int) {
+        let n = position - base[i]
+        guard n > 0 else { return }
+        let skip = min(n, max(0, nFFT[i] / 2 - base[i]))
+        mixInput[i] = concatenated([
+            mixInput[i], ola[i][skip ..< n] / maximum(envelope[i][skip ..< n], 1e-12),
+        ])
+        ola[i] = ola[i][n...]
+        envelope[i] = envelope[i][n...]
+        base[i] = position
+    }
+
+    private func emit() -> MLXArray {
+        let k = mixer.dim(1)
+        let length = min(mixInput[0].size, mixInput[1].size) - k + 1
+        guard length > 0 else { return .zeros([0]) }
+        let take = length + k - 1
+        let x = stacked(mixInput.map { $0[0 ..< take] }, axis: -1)[.newAxis]
+        let out = conv1d(x, mixer.T[.newAxis])[0, 0..., 0]
+        mixInput = mixInput.map { $0[length...] }
+        mixBase += length
+        return out
+    }
+
+    func flush() -> MLXArray {
+        guard !done, frames > 0 else { return .zeros([0]) }
+        done = true
+        for i in 0 ..< 2 {
+            finalize(i, through: base[i] + ola[i].size)
+            let keep = half + frames * hop - mixBase
+            var x = mixInput[i]
+            if x.size >= keep {
+                x = x[0 ..< keep]
+            } else {
+                x = concatenated([x, .zeros([keep - x.size])])
+            }
+            mixInput[i] = concatenated([x, .zeros([half])])
+        }
+        return emit()
+    }
+}
+
+final class Zonos3ResamplerStream {
+    let kernel: MLXArray, orig: Int, new: Int, width: Int
+    var buffer = MLXArray.zeros([0])
+    var base = 0, inputCount = 0, nextBlock = 0
+    init(kernel: MLXArray, orig: Int, new: Int, width: Int) {
+        self.kernel = kernel
+        self.orig = orig
+        self.new = new
+        self.width = width
+    }
+    func push(_ x: MLXArray) -> MLXArray {
+        buffer = concatenated([buffer, x])
+        inputCount += x.size
+        return run(flush: false)
+    }
+    func flush() -> MLXArray { run(flush: true) }
+    private func run(flush: Bool) -> MLXArray {
+        let taps = 2 * width + orig
+        let total = (new * inputCount + orig - 1) / orig
+        let reach = inputCount + width - taps
+        let end = flush ? (total + new - 1) / new : (reach >= 0 ? reach / orig + 1 : 0)
+        var out = MLXArray.zeros([0])
+        if end > nextBlock {
+            let lo = nextBlock * orig - width
+            let hi = (end - 1) * orig - width + taps
+            let segment = MLXArray.zeros([hi - lo])
+            let a = max(lo, 0)
+            let b = min(hi, inputCount)
+            if b > a { segment[(a - lo) ..< (b - lo)] = buffer[(a - base) ..< (b - base)] }
+            let windows = asStrided(segment, [end - nextBlock, taps], strides: [orig, 1])
+            out = matmul(windows, kernel.T).reshaped(-1)
+            if flush { out = out[0 ..< max(0, total - nextBlock * new)] }
+            nextBlock = end
+        }
+        let keep = min(inputCount, max(0, nextBlock * orig - width))
+        if keep > base {
+            buffer = buffer[(keep - base)...]
+            base = keep
+        }
+        return out
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Configuration.swift b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Configuration.swift
new file mode 100644
index 0000000..dc5d90e
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Configuration.swift
@@ -0,0 +1,167 @@
+import Foundation
+
+/// Metadata shipped in `mlx-community/ZONOS3-Mini/config.json`.
+public struct Zonos3Configuration: Codable, Sendable {
+    public var modelType: String
+    public var backbone: Zonos3BackboneConfiguration
+    public var tensors: [String: Zonos3TensorSpecification]
+
+    static func load(_ url: URL) throws -> Self {
+        let decoder = JSONDecoder()
+        let config = try decoder.decode(Self.self, from: Data(contentsOf: url))
+        try config.backbone.validate()
+        return config
+    }
+    enum CodingKeys: String, CodingKey {
+        case modelType = "model_type"
+        case backbone
+        case tensors
+    }
+
+}
+
+public struct Zonos3TensorSpecification: Codable, Sendable {
+    public var shape: [Int]
+    public var matrix: Bool
+    public var dtype: String
+    public var bits: Int?
+}
+
+public struct Zonos3BackboneConfiguration: Codable, Sendable {
+    public var nLayers: Int
+    public var maxSeqlen: Int
+    public var dim: Int
+    public var headDim: Int
+    public var nHeads: Int
+    public var nKvHeads: Int
+    public var ffnHidden: Int
+    public var nExperts: Int
+    public var moeTopk: Int
+    public var nCodebooks: Int
+    public var codebookSize: Int
+    public var audioVocab: Int
+    public var eoaId: Int
+    public var audioPadId: Int
+    public var spanEndId: Int?
+    public var textVocab: Int
+    public var textExtraTokens: Int
+    public var gdnHeads: Int
+    public var gdnHeadDim: Int
+    public var gdnKernel: Int
+    public var speakerEmbeddingDim: Int
+    public var conditionCount: Int
+    public var conditionBucketCounts: [Int]
+    public var conditionNames: [String]
+    public var conditionUnits: [String: String]
+    public var conditionEdges: [String: [Double]]
+    public var ropeTheta: Float
+    public var normEps: Float
+    public var qkEps: Float
+    public var lossSoftcap: Float
+    public var gdnPeriod: Int
+    public var silenceFrame: [Int]
+    public var textTokenizerSpec: Zonos3TokenizerSpecification
+
+    func validate() throws {
+        guard nLayers > 0, dim > 0, maxSeqlen > 0, headDim > 0,
+            nKvHeads > 0, nHeads > 0, nHeads % nKvHeads == 0,
+            gdnHeads > 0, gdnHeadDim > 0, gdnKernel > 1, gdnPeriod > 0,
+            nExperts > 0, moeTopk > 0, moeTopk <= nExperts,
+            nCodebooks > 0, silenceFrame.count == nCodebooks,
+            silenceFrame.allSatisfy({ (0 ..< codebookSize).contains($0) }),
+            eoaId == codebookSize, audioPadId == codebookSize + 1,
+            audioVocab == codebookSize + 2, speakerEmbeddingDim > 0,
+            conditionNames.count == conditionCount, conditionBucketCounts.count == conditionCount,
+            normEps > 0, qkEps > 0, lossSoftcap > 0, ropeTheta > 0
+        else { throw Zonos3Error.invalidConfiguration("Inconsistent backbone dimensions") }
+        for (name, count) in zip(conditionNames, conditionBucketCounts) {
+            guard count > 0, let edges = conditionEdges[name], edges.count == count - 1,
+                edges.allSatisfy(\.isFinite), edges == edges.sorted()
+            else { throw Zonos3Error.invalidConfiguration("Invalid condition: \(name)") }
+        }
+    }
+    enum CodingKeys: String, CodingKey {
+        case nLayers = "n_layers"
+        case maxSeqlen = "max_seqlen"
+        case dim
+        case headDim = "head_dim"
+        case nHeads = "n_heads"
+        case nKvHeads = "n_kv_heads"
+        case ffnHidden = "ffn_hidden"
+        case nExperts = "n_experts"
+        case moeTopk = "moe_topk"
+        case nCodebooks = "n_codebooks"
+        case codebookSize = "codebook_size"
+        case audioVocab = "audio_vocab"
+        case eoaId = "eoa_id"
+        case audioPadId = "audio_pad_id"
+        case spanEndId = "span_end_id"
+        case textVocab = "text_vocab"
+        case textExtraTokens = "text_extra_tokens"
+        case gdnHeads = "gdn_heads"
+        case gdnHeadDim = "gdn_head_dim"
+        case gdnKernel = "gdn_kernel"
+        case speakerEmbeddingDim = "speaker_embedding_dim"
+        case conditionCount = "condition_count"
+        case conditionBucketCounts = "condition_bucket_counts"
+        case conditionNames = "condition_names"
+        case conditionUnits = "condition_units"
+        case conditionEdges = "condition_edges"
+        case ropeTheta = "rope_theta"
+        case normEps = "norm_eps"
+        case qkEps = "qk_eps"
+        case lossSoftcap = "loss_softcap"
+        case gdnPeriod = "gdn_period"
+        case silenceFrame = "silence_frame"
+        case textTokenizerSpec = "text_tokenizer_spec"
+    }
+
+}
+
+public struct Zonos3TokenizerSpecification: Codable, Sendable {
+    public var kind: String
+    public var path: String
+    public var sha256: String
+    public var vocabSize: Int
+    public var offset: Int
+    public var bos: Int
+    public var eos: Int
+    enum CodingKeys: String, CodingKey {
+        case kind
+        case path
+        case sha256
+        case vocabSize = "vocab_size"
+        case offset
+        case bos
+        case eos
+    }
+
+}
+
+public enum Zonos3Error: Error, LocalizedError {
+    case invalidConfiguration(String)
+    case invalidInput(String)
+    case invalidCheckpoint(String)
+
+    public var errorDescription: String? {
+        switch self {
+        case .invalidConfiguration(let message), .invalidInput(let message),
+            .invalidCheckpoint(let message):
+            "ZONOS3: \(message)"
+        }
+    }
+}
+
+/// Controls specific to ZONOS3. Reference waveforms are mono PCM at 44,100 Hz.
+public struct Zonos3Options: Sendable {
+    public var speed: Float = 1
+    public var speakerCFGScale: Float = 1
+    public var conditionBuckets: [String: Int]?
+    public var conditionValues: [String: Double]?
+    public var minFrames: Int = 0
+    public var silencePrefillFrames: Int = 3
+    public var repetitionCodebooks: Int = 6
+    public var textNormalization: Bool = true
+    public var headroomDB: Float?
+    public init() {}
+}
diff --git a/Sources/MLXAudioTTS/Models/Zonos3/Zonos3DeltaKernel.swift b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3DeltaKernel.swift
new file mode 100644
index 0000000..0615704
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3DeltaKernel.swift
@@ -0,0 +1,113 @@
+// Copyright © 2025 Apple Inc. Adapted from mlx-lm under the MIT License.
+import MLX
+import MLXFast
+
+enum Zonos3DeltaKernel {
+    private static let kernel = MLXFast.metalKernel(
+        name: "zonos3_gated_delta",
+        inputNames: ["q", "k", "v", "g", "beta", "state_in"], outputNames: ["y", "state_out"],
+        source: """
+
+            auto n = thread_position_in_grid.z;
+            auto b_idx = n / Hv;
+            auto hv_idx = n % Hv;
+            auto hk_idx = hv_idx / (Hv / Hk);
+            constexpr int n_per_t = Dk / 32;
+
+            // q, k: [B, T, Hk, Dk]
+            auto q_ = q + b_idx * T * Hk * Dk + hk_idx * Dk;
+            auto k_ = k + b_idx * T * Hk * Dk + hk_idx * Dk;
+
+            // v, y: [B, T, Hv, Dv]
+            auto v_ = v + b_idx * T * Hv * Dv + hv_idx * Dv;
+            y += b_idx * T * Hv * Dv + hv_idx * Dv;
+
+            auto dk_idx = thread_position_in_threadgroup.x;
+            auto dv_idx = thread_position_in_grid.y;
+
+            // state_in, state_out: [B, Hv, Dv, Dk]
+            auto i_state = state_in + (n * Dv + dv_idx) * Dk;
+            auto o_state = state_out + (n * Dv + dv_idx) * Dk;
+
+            float state[n_per_t];
+            for (int i = 0; i < n_per_t; ++i) {
+              auto s_idx = n_per_t * dk_idx + i;
+              state[i] = static_cast<float>(i_state[s_idx]);
+            }
+
+            // g: [B, T, Hv]
+            auto g_ = g + b_idx * T * Hv;
+            auto beta_ = beta + b_idx * T * Hv;
+
+            for (int t = 0; t < T; ++t) {
+              float kv_mem = 0.0f;
+              for (int i = 0; i < n_per_t; ++i) {
+                auto s_idx = n_per_t * dk_idx + i;
+                state[i] = state[i] * g_[hv_idx];
+                kv_mem += state[i] * k_[s_idx];
+              }
+              kv_mem = simd_sum(kv_mem);
+
+              auto delta = (v_[dv_idx] - kv_mem) * beta_[hv_idx];
+
+              float out = 0.0f;
+              for (int i = 0; i < n_per_t; ++i) {
+                auto s_idx = n_per_t * dk_idx + i;
+                state[i] = state[i] + k_[s_idx] * delta;
+                out += state[i] * q_[s_idx];
+              }
+              out = simd_sum(out);
+              if (thread_index_in_simdgroup == 0) {
+                y[dv_idx] = static_cast<InT>(out);
+              }
+              // Increment data pointers to next time step
+              q_ += Hk * Dk;
+              k_ += Hk * Dk;
+              v_ += Hv * Dv;
+              y += Hv * Dv;
+              g_ += Hv;
+              beta_ += Hv;
+            }
+            for (int i = 0; i < n_per_t; ++i) {
+              auto s_idx = n_per_t * dk_idx + i;
+              o_state[s_idx] = static_cast<StT>(state[i]);
+            }
+
+            """)
+    static func callAsFunction(
+        q: MLXArray, k: MLXArray, v: MLXArray, decay: MLXArray,
+        beta: MLXArray, state: MLXArray
+    ) -> (MLXArray, MLXArray) {
+        let b = q.dim(0)
+        let t = q.dim(1)
+        let h = q.dim(2)
+        let d = q.dim(3)
+        if t > 1 && d % 32 == 0 && Device.defaultDevice() == .gpu {
+            let out = kernel(
+                [q, k, v, decay, beta, state],
+                template: [
+                    ("InT", DType.float32), ("StT", DType.float32), ("T", t),
+                    ("Hk", h), ("Hv", h), ("Dk", d), ("Dv", d),
+                ],
+                grid: (32, d, b * h), threadGroup: (32, 4, 1),
+                outputShapes: [v.shape, state.shape], outputDTypes: [.float32, .float32])
+            return (out[0], out[1])
+        }
+        return reference(q: q, k: k, v: v, decay: decay, beta: beta, state: state)
+    }
+    static func reference(
+        q: MLXArray, k: MLXArray, v: MLXArray, decay: MLXArray,
+        beta: MLXArray, state initial: MLXArray
+    ) -> (MLXArray, MLXArray) {
+        var state = initial
+        var outputs: [MLXArray] = []
+        for t in 0 ..< q.dim(1) {
+            let key = k[0..., t, 0..., .newAxis, 0...]
+            state = state * decay[0..., t, 0..., .newAxis, .newAxis]
+            let delta = (v[0..., t] - (state * key).sum(axis: -1)) * beta[0..., t, 0..., .newAxis]
+            state = state + key * delta[0..., 0..., 0..., .newAxis]
+            outputs.append((state * q[0..., t, 0..., .newAxis, 0...]).sum(axis: -1))
+        }
+        return (stacked(outputs, axis: 1), state)
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Generation.swift b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Generation.swift
new file mode 100644
index 0000000..44ec9e8
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Generation.swift
@@ -0,0 +1,157 @@
+import CryptoKit
+import Foundation
+import Hub
+import MLX
+import MLXAudioCore
+import MLXRandom
+import Tokenizers
+
+final class Zonos3TextTokenizer {
+    let tokenizer: any Tokenizer
+    init(directory: URL, config: Zonos3BackboneConfiguration) throws {
+        let spec = config.textTokenizerSpec
+        guard spec.kind == "superbpe", spec.offset == 4, spec.bos == 2, spec.eos == 3,
+            config.textVocab == spec.vocabSize + 4,
+            spec.path == URL(fileURLWithPath: spec.path).lastPathComponent
+        else {
+            throw Zonos3Error.invalidCheckpoint("Unsupported SuperBPE convention")
+        }
+        let raw = try Data(contentsOf: directory.appendingPathComponent(spec.path))
+        let hash = SHA256.hash(data: raw).map { String(format: "%02x", $0) }.joined()
+        guard hash == spec.sha256,
+            let json = try JSONSerialization.jsonObject(with: raw) as? [NSString: Any],
+            let model = json["model"] as? [String: Any],
+            let vocab = model["vocab"] as? [String: Int],
+            vocab.count == spec.vocabSize,
+            json["padding"] is NSNull, json["truncation"] is NSNull
+        else {
+            throw Zonos3Error.invalidCheckpoint("SuperBPE artifact mismatch")
+        }
+        tokenizer = try PreTrainedTokenizer(
+            tokenizerConfig: ["tokenizer_class": "PreTrainedTokenizer"], tokenizerData: Config(json)
+        )
+    }
+    func encode(_ text: String) -> [Int] {
+        [2] + tokenizer.encode(text: text, addSpecialTokens: false).map { $0 + 4 } + [3]
+    }
+}
+
+enum Zonos3Generation {
+    static func conditions(_ c: Zonos3BackboneConfiguration, options: Zonos3Options) throws -> [Int]
+    {
+        guard options.speed.isFinite, options.speed > 0, options.speakerCFGScale.isFinite,
+            options.speakerCFGScale >= 0,
+            options.minFrames >= 0, (0 ... 30).contains(options.silencePrefillFrames),
+            options.headroomDB?.isFinite != false,
+            options.conditionBuckets == nil || options.conditionValues == nil
+        else {
+            throw Zonos3Error.invalidInput("Invalid speed, guidance, conditions, or frame settings")
+        }
+        var values = options.conditionValues
+        if options.speed != 1 {
+            guard options.conditionBuckets == nil, values == nil else {
+                throw Zonos3Error.invalidInput("Speed cannot be combined with explicit conditions")
+            }
+            values = ["speaking_rate": 15.193 * Double(options.speed)]
+        }
+        let keys = Set(values?.keys.map { $0 } ?? options.conditionBuckets?.keys.map { $0 } ?? [])
+        guard keys.isSubset(of: Set(c.conditionNames)) else {
+            throw Zonos3Error.invalidInput("Unknown acoustic condition")
+        }
+        return try zip(c.conditionNames, c.conditionBucketCounts).map { name, count in
+            if let value = values?[name] {
+                guard value.isFinite else {
+                    throw Zonos3Error.invalidInput("Condition values must be finite")
+                }
+                return c.conditionEdges[name]!.filter { $0 <= value }.count
+            }
+            let bucket = options.conditionBuckets?[name] ?? count
+            guard (0 ... count).contains(bucket) else {
+                throw Zonos3Error.invalidInput("Invalid \(name) bucket")
+            }
+            return bucket
+        }
+    }
+    static func delay(_ codes: MLXArray, pad: Int, flush: Bool = true) -> MLXArray {
+        let length = codes.dim(0)
+        let channels = codes.dim(1)
+        let out = MLXArray.full(
+            [length + (flush ? channels - 1 : 0), channels], values: MLXArray(pad), dtype: .int32)
+        for cb in 0 ..< channels {
+            let count = min(length, out.dim(0) - cb)
+            if count > 0 { out[cb ..< (cb + count), cb] = codes[0 ..< count, cb] }
+        }
+        return out
+    }
+    static func aligned(_ rows: MLXArray, codebooks: Int, stop: Int? = nil, start: Int = 0)
+        -> MLXArray
+    {
+        let length = min(max(0, rows.dim(0) - codebooks + 1), stop ?? Int.max)
+        if length <= start { return .zeros([0, codebooks], dtype: .int32) }
+        return stacked(
+            (0 ..< codebooks).map { cb in rows[(start + cb) ..< (length + cb), cb] }, axis: -1)
+    }
+    static func sample(
+        _ logits: MLXArray, config c: Zonos3BackboneConfiguration, step: Int,
+        history: MLXArray, parameters p: GenerateParameters, options: Zonos3Options, hasPrefix: Bool
+    ) -> MLXArray {
+        let ids = MLXArray(0 ..< c.audioVocab)[.newAxis]
+        var invalid = (ids .== c.audioPadId) .|| ((ids .>= c.codebookSize) .&& (ids .!= c.eoaId))
+        let beforeMinimum =
+            (options.minFrames + MLXArray(0 ..< c.nCodebooks))[0..., .newAxis] .> step
+        invalid = logicalOr(invalid, logicalAnd(ids .== c.eoaId, beforeMinimum))
+        var x = MLX.where(invalid, -Float.infinity, logits.asType(.float32))
+        let window = min(max(0, p.repetitionContextSize), history.dim(0))
+        let penalty = p.repetitionPenalty ?? 2.4
+        if window > 0 && penalty > 1 && options.repetitionCodebooks != 0 {
+            let recent = history[(history.dim(0) - window)...].T
+            var valid = (recent .>= 0) .&& (recent .< c.codebookSize)
+            if options.repetitionCodebooks >= 0 {
+                let penalized =
+                    MLXArray(0 ..< c.nCodebooks)[0..., .newAxis] .< options.repetitionCodebooks
+                valid = logicalAnd(valid, penalized)
+            }
+            let counts = MLXArray.zeros(logits.shape, dtype: .int32).at[
+                MLXArray(0 ..< c.nCodebooks)[0..., .newAxis],
+                clip(recent, min: 0, max: c.audioVocab - 1)
+            ].add(valid.asType(.int32))
+            x = MLX.where(counts .> 0, MLX.where(x .> 0, x / penalty, x * penalty), x)
+        }
+        var token: MLXArray
+        if p.temperature <= 0 {
+            token = argMax(x, axis: -1)
+        } else {
+            x = x / p.temperature
+            if p.topK > 0 && p.topK < c.audioVocab {
+                let threshold = top(x, k: p.topK, axis: -1).min(axis: -1, keepDims: true)
+                x = MLX.where(x .< threshold, -Float.infinity, x)
+            }
+            var probs = softmax(x, axis: -1)
+            if p.topP > 0 && p.topP < 1 {
+                let order = argSort(-probs, axis: -1)
+                let ranked = takeAlong(probs, order, axis: -1)
+                let selected = MLX.where(cumsum(ranked, axis: -1) - ranked .> p.topP, 0, ranked)
+                probs = putAlong(.zeros(probs.shape), order, values: selected, axis: -1)
+                probs = probs / maximum(probs.sum(axis: -1, keepDims: true), 1e-8)
+            }
+            if p.minP > 0 {
+                probs = MLX.where(probs .< p.minP * probs.max(axis: -1, keepDims: true), 0, probs)
+            }
+            let greedy = ids .== argMax(x, axis: -1, keepDims: true)
+            probs = MLX.where(probs.sum(axis: -1, keepDims: true) .<= 0, greedy, probs)
+            token = MLXRandom.categorical(
+                log(probs), key: p.seed.map { MLXRandom.key($0 &+ UInt64(step)) })
+        }
+        if !hasPrefix {
+            token = MLX.where(MLXArray(0 ..< c.nCodebooks) .> step, c.audioPadId, token)
+        }
+        return token.asType(.int32)
+    }
+    static func output(_ audio: MLXArray, gain: Float) -> MLXArray {
+        let scaled = audio.asType(.float32) * gain
+        let knee = pow(Float(10), -1 / 20)
+        let magnitude = abs(scaled)
+        let limited = knee + (1 - knee) * tanh((magnitude - knee) / (1 - knee))
+        return MLX.where(magnitude .> knee, sign(scaled) * limited, scaled)
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Model.swift b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Model.swift
new file mode 100644
index 0000000..8ca9c84
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Model.swift
@@ -0,0 +1,311 @@
+import Foundation
+import HuggingFace
+@preconcurrency import MLX
+@preconcurrency import MLXAudioCore
+import MLXNN
+
+/// ZONOS3-Mini synthesis. Serialize calls on each model instance.
+public final class Zonos3Model: Module, SpeechGenerationModel, @unchecked Sendable {
+    public static let defaultRepositoryID = "mlx-community/ZONOS3-Mini"
+    public let config: Zonos3Configuration
+    public var sampleRate: Int { 44100 }
+    public var voices: [String] { voiceFiles.keys.sorted() }
+    public var defaultGenerationParameters: GenerateParameters {
+        .init(
+            maxTokens: 2000, temperature: 0.75, topP: 0.69, topK: 80,
+            repetitionPenalty: 2.4, repetitionContextSize: 96)
+    }
+    let backbone: Zonos3Backbone
+    let directory: URL
+    let tokenizer: Zonos3TextTokenizer
+    let voiceFiles: [String: String]
+    private var codec: Zonos3Codec?
+    private var speakerEncoder: Zonos3SpeakerEncoder?
+
+    private init(
+        config: Zonos3Configuration, directory: URL, params: Zonos3TensorStore,
+        tokenizer: Zonos3TextTokenizer, voices: [String: String]
+    ) {
+        self.config = config
+        self.directory = directory
+        backbone = Zonos3Backbone(config.backbone, params: params)
+        self.tokenizer = tokenizer
+        voiceFiles = voices
+    }
+    public static func fromPretrained(
+        _ repository: String = defaultRepositoryID,
+        cache: HubCache = .default, hfToken: String? = nil
+    ) async throws -> Zonos3Model {
+        guard let id = Repo.ID(rawValue: repository) else {
+            throw TTSModelError.invalidRepositoryID(repository)
+        }
+        let directory = try await ModelUtils.resolveOrDownloadModel(
+            repoID: id,
+            requiredExtension: ".safetensors", additionalMatchingPatterns: ["*.npz"],
+            hfToken: hfToken, cache: cache)
+        return try await fromModelDirectory(directory)
+    }
+    public static func fromModelDirectory(_ directory: URL) async throws -> Zonos3Model {
+        let config = try Zonos3Configuration.load(directory.appendingPathComponent("config.json"))
+        guard ["zonos3", "zonos3_mini"].contains(config.modelType) else {
+            throw Zonos3Error.invalidCheckpoint("Expected a native ZONOS3 checkpoint")
+        }
+        let weights = try loadArrays(url: directory.appendingPathComponent("model.safetensors"))
+        let params = try Zonos3TensorStore(
+            specs: config.tensors, weights: weights, prefix: "backbone.params.")
+        let tokenizer = try Zonos3TextTokenizer(directory: directory, config: config.backbone)
+        let voices = try JSONDecoder().decode(
+            [String: String].self,
+            from: Data(contentsOf: directory.appendingPathComponent("voices.json")))
+        guard
+            voices.values.allSatisfy({
+                $0 == URL(fileURLWithPath: $0).lastPathComponent && $0.hasSuffix(".npz")
+            })
+        else {
+            throw Zonos3Error.invalidCheckpoint("Invalid voice manifest paths")
+        }
+        eval(params.arrays)
+        return Zonos3Model(
+            config: config, directory: directory, params: params, tokenizer: tokenizer,
+            voices: voices)
+    }
+    /// Extract a 192-dimensional embedding. Input is mono PCM at 44,100 Hz, capped at 60 seconds.
+    public func extractSpeakerEmbedding(_ audio: MaterializedArray) throws -> MaterializedArray {
+        try speakerEmbedding(audio).materialized()
+    }
+    private func speakerEmbedding(_ pcm: MLXArray) throws -> MLXArray {
+        guard pcm.ndim == 1, pcm.size > 0, all(isFinite(pcm)).item(Bool.self) else {
+            throw Zonos3Error.invalidInput("Reference must be finite mono PCM at 44,100 Hz")
+        }
+        if speakerEncoder == nil {
+            speakerEncoder = try Zonos3SpeakerEncoder(
+                directory.appendingPathComponent("speaker_encoder"))
+        }
+        return try speakerEncoder!.embed(pcm)
+    }
+    private func embedding(voice: String?, reference: MLXArray?, supplied: MLXArray?) throws
+        -> MLXArray?
+    {
+        guard reference == nil || supplied == nil else {
+            throw Zonos3Error.invalidInput(
+                "Reference audio and speaker embedding are mutually exclusive")
+        }
+        let result: MLXArray
+        if let reference {
+            result = try speakerEmbedding(reference)
+        } else if let supplied {
+            result = supplied
+        } else {
+            let name = (voice ?? "jett").lowercased()
+            if name == "none" { return nil }
+            guard let filename = voiceFiles[name],
+                let vector = try NumpyArchive.load(
+                    url: directory.appendingPathComponent("voices/" + filename))["embedding"]
+            else {
+                throw Zonos3Error.invalidInput(
+                    "Unknown voice \(name); available: \(voices.joined(separator: ", "))")
+            }
+            result = vector
+        }
+        guard
+            result.shape == [config.backbone.speakerEmbeddingDim]
+                || result.shape == [1, config.backbone.speakerEmbeddingDim],
+            all(isFinite(result)).item(Bool.self)
+        else {
+            throw Zonos3Error.invalidInput(
+                "Expected a finite \(config.backbone.speakerEmbeddingDim)-dimensional speaker embedding"
+            )
+        }
+        return result.asType(.float32).reshaped(-1)
+    }
+
+    private func run(
+        text: String, voice: String?, reference: MLXArray?, supplied: MLXArray?, language: String?,
+        parameters p: GenerateParameters, options: Zonos3Options, interval: Double,
+        emit: ((MLXArray) throws -> Void)? = nil
+    ) throws -> (MLXArray, AudioGenerationInfo) {
+        try Task.checkCancellation()
+        guard !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+            interval.isFinite, interval > 0, p.temperature.isFinite, p.topP.isFinite,
+            p.minP.isFinite,
+            p.repetitionPenalty?.isFinite != false
+        else { throw Zonos3Error.invalidInput("Empty text or invalid sampling settings") }
+        let c = config.backbone
+        let buckets = try Zonos3Generation.conditions(c, options: options)
+        let speaker = try embedding(voice: voice, reference: reference, supplied: supplied)
+        guard options.speakerCFGScale == 1 || speaker != nil else {
+            throw Zonos3Error.invalidInput("Speaker guidance needs an embedding")
+        }
+        let text =
+            options.textNormalization
+            ? Zonos2Text.normalize(text, language: language ?? "en") : text
+        let tokens = tokenizer.encode(text)
+        let offset = speaker == nil ? 0 : 1
+        let rows = MLXArray.full(
+            [offset + c.conditionCount + tokens.count, c.nCodebooks + 1],
+            values: MLXArray(c.audioPadId), dtype: .int32)
+        rows[0..., c.nCodebooks] = MLXArray(c.textVocab)
+        rows[(offset + c.conditionCount)..., c.nCodebooks] = MLXArray(tokens).asType(.int32)
+        let silence = Zonos3Generation.delay(
+            broadcast(
+                MLXArray(c.silenceFrame).asType(.int32),
+                to: [options.silencePrefillFrames, c.nCodebooks]), pad: c.audioPadId, flush: false)
+        let prompt =
+            silence.dim(0) > 0
+            ? concatenated([
+                rows,
+                concatenated(
+                    [
+                        silence,
+                        .full([silence.dim(0), 1], values: MLXArray(c.textVocab), dtype: .int32),
+                    ], axis: -1),
+            ]) : rows
+        let budget = min(p.maxTokens ?? 2000, c.maxSeqlen - prompt.dim(0))
+        guard budget > 0 else {
+            throw Zonos3Error.invalidInput(
+                "Token budget must be positive and leave context for audio")
+        }
+        let start = Date()
+        let state = Zonos3LMState()
+        var logits = try backbone(prompt, state: state, speaker: speaker, conditions: buckets)[-1]
+        let twin = options.speakerCFGScale != 1 ? Zonos3LMState() : nil
+        var twinLogits: MLXArray?
+        if let twin {
+            twinLogits = try backbone(
+                prompt[1...], state: twin, conditions: c.conditionBucketCounts)[-1]
+        }
+        eval([logits] + state.arrays + (twin?.arrays ?? []) + [twinLogits].compactMap { $0 })
+        let prefill = Date().timeIntervalSince(start)
+        if codec == nil { codec = try Zonos3Codec(directory.appendingPathComponent("codec")) }
+        let decoder = codec!
+        let stream = emit == nil ? nil : Zonos3CodecStream(codec!)
+        let history = MLXArray.zeros([silence.dim(0) + budget, c.nCodebooks], dtype: .int32)
+        if silence.dim(0) > 0 { history[0 ..< silence.dim(0)] = silence }
+        var stop: Int?
+        var decoded = 0
+        var generated = 0
+        let chunkFrames = max(1, Int(min(interval * 15, Double(budget)).rounded()))
+        for step in 0 ..< budget {
+            try Task.checkCancellation()
+            let t = silence.dim(0) + step
+            let guided = twinLogits.map { $0 + options.speakerCFGScale * (logits - $0) } ?? logits
+            let token = Zonos3Generation.sample(
+                guided, config: c, step: step, history: history[0 ..< t],
+                parameters: p, options: options, hasPrefix: silence.dim(0) > 0)
+            history[t] = token
+            let column = MLX.max(MLX.where(token .== c.eoaId, MLXArray(0 ..< c.nCodebooks), -1))
+            eval([history, column] + state.arrays + (twin?.arrays ?? []))
+            let lastStop = column.item(Int.self)
+            if lastStop >= 0 { stop = min(stop ?? Int.max, max(0, t - lastStop)) }
+            let ready = min(max(0, t + 2 - c.nCodebooks), stop ?? Int.max)
+            if let stream, ready - decoded >= chunkFrames {
+                let codes = Zonos3Generation.aligned(
+                    history[0 ... t], codebooks: c.nCodebooks, stop: stop, start: decoded)
+                let audio = try stream.decode(codes)
+                decoded = ready
+                if audio.size > 0 {
+                    try emit?(
+                        Zonos3Generation.output(audio, gain: decoder.gain(options.headroomDB)))
+                }
+            }
+            generated = step + 1
+            if let stop, t >= stop + c.nCodebooks - 1 { break }
+            if step + 1 < budget {
+                let next = concatenated([token, MLXArray([Int32(c.textVocab)])])[.newAxis]
+                logits = try backbone(next, state: state)[-1]
+                if let twin { twinLogits = try backbone(next, state: twin)[-1] }
+            }
+        }
+        let codes = Zonos3Generation.aligned(
+            history[0 ..< (silence.dim(0) + generated)], codebooks: c.nCodebooks, stop: stop)
+        let audio: MLXArray
+        if let stream {
+            var tail: [MLXArray] = []
+            if codes.dim(0) > decoded { tail.append(try stream.decode(codes[decoded...])) }
+            tail.append(stream.flush())
+            audio = Zonos3Generation.output(
+                concatenated(tail), gain: decoder.gain(options.headroomDB))
+            if audio.size > 0 { try emit?(audio) }
+        } else {
+            audio = Zonos3Generation.output(
+                try decoder.decode(codes), gain: decoder.gain(options.headroomDB))
+        }
+        eval(audio)
+        let elapsed = Date().timeIntervalSince(start) - prefill
+        return (
+            audio,
+            AudioGenerationInfo(
+                promptTokenCount: prompt.dim(0), generationTokenCount: generated,
+                prefillTime: prefill, generateTime: elapsed,
+                tokensPerSecond: Double(generated) / max(elapsed, 1e-9),
+                peakMemoryUsage: Double(Memory.peakMemory) / 1e9)
+        )
+    }
+
+    public func generate(
+        text: String, voice: String?, refAudio: MaterializedArray?, refText: String?,
+        language: String?,
+        generationParameters: GenerateParameters
+    ) async throws -> MaterializedArray {
+        try await generate(
+            text: text, voice: voice, refAudio: refAudio, language: language,
+            generationParameters: generationParameters, options: .init())
+    }
+    public func generate(
+        text: String, voice: String? = nil, refAudio: MaterializedArray? = nil,
+        speakerEmbedding: MaterializedArray? = nil, language: String? = nil,
+        generationParameters: GenerateParameters? = nil, options: Zonos3Options = .init()
+    ) async throws -> MaterializedArray {
+        try run(
+            text: text, voice: voice, reference: refAudio, supplied: speakerEmbedding,
+            language: language,
+            parameters: generationParameters ?? defaultGenerationParameters, options: options,
+            interval: 0.5
+        ).0.materialized()
+    }
+    public func generateStream(
+        text: String, voice: String?, refAudio: MaterializedArray?, refText: String?,
+        language: String?,
+        generationParameters: GenerateParameters
+    ) -> AsyncThrowingStream<AudioGeneration, Error> {
+        generateStream(
+            text: text, voice: voice, refAudio: refAudio, language: language,
+            generationParameters: generationParameters, streamingInterval: 0.5, options: .init())
+    }
+    public func generateStream(
+        text: String, voice: String?, refAudio: MaterializedArray?, refText: String?,
+        language: String?,
+        generationParameters: GenerateParameters, streamingInterval: Double
+    ) -> AsyncThrowingStream<AudioGeneration, Error> {
+        generateStream(
+            text: text, voice: voice, refAudio: refAudio, language: language,
+            generationParameters: generationParameters, streamingInterval: streamingInterval,
+            options: .init())
+    }
+    public func generateStream(
+        text: String, voice: String? = nil, refAudio: MaterializedArray? = nil,
+        speakerEmbedding: MaterializedArray? = nil, language: String? = nil,
+        generationParameters: GenerateParameters? = nil, streamingInterval: Double = 0.5,
+        options: Zonos3Options = .init()
+    ) -> AsyncThrowingStream<AudioGeneration, Error> {
+        AsyncThrowingStream { continuation in
+            let task = Task { @Sendable [self] in
+                do {
+                    let (_, info) = try run(
+                        text: text, voice: voice, reference: refAudio, supplied: speakerEmbedding,
+                        language: language,
+                        parameters: generationParameters ?? defaultGenerationParameters,
+                        options: options, interval: streamingInterval
+                    ) { audio in
+                        if case .terminated = continuation.yield(.audio(audio)) {
+                            throw CancellationError()
+                        }
+                    }
+                    continuation.yield(.info(info))
+                    continuation.finish()
+                } catch { continuation.finish(throwing: error) }
+            }
+            continuation.onTermination = { @Sendable _ in task.cancel() }
+        }
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Speaker.swift b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Speaker.swift
new file mode 100644
index 0000000..7b28c3d
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Speaker.swift
@@ -0,0 +1,242 @@
+// Copyright (c) 2026 Zyphra, Inc. Adapted under the MIT License.
+import Accelerate
+import Foundation
+import MLX
+import MLXAudioCore
+import MLXFast
+import MLXNN
+
+/// MECT-B2 speaker encoder with the checkpoint's Kaldi frontend.
+final class Zonos3SpeakerEncoder {
+    let p: Zonos3TensorStore
+    let window: [Double], melBanks: [Double], resampleKernel: MLXArray
+    let preemphasis: Double, waveformScale: Double, logFloor: Double
+    let lnEps: Float, varianceFloor: Float
+    var grouped: [String: MLXArray] = [:]
+
+    init(_ directory: URL) throws {
+        let file = try Zonos3Component(directory, architecture: "mect_spk")
+        p = file.params
+        let m = file.metadata
+        guard m["mect_spk.backbone"] as? String == "MECT_B2",
+            m["mect_spk.embedding_length"] as? Int == 192,
+            m["mect_spk.n_fft"] as? Int == 512, m["mect_spk.n_mels"] as? Int == 80,
+            m["mect_spk.frame_length"] as? Int == 400, m["mect_spk.frame_shift"] as? Int == 160
+        else { throw Zonos3Error.invalidCheckpoint("Expected MECT-B2 speaker encoder") }
+        func number(_ key: String) throws -> Double {
+            guard let n = m["mect_spk." + key] as? Double else {
+                throw Zonos3Error.invalidCheckpoint("Missing speaker metadata: \(key)")
+            }
+            return n
+        }
+        preemphasis = try number("preemphasis")
+        waveformScale = try number("waveform_scale")
+        logFloor = try number("log_floor")
+        lnEps = Float(try number("ln_eps"))
+        varianceFloor = Float(try number("pool_var_floor"))
+        let host = try NumpyArchive.load(url: directory.appendingPathComponent("frontend.npz"))
+        guard let win = host["frontend.window"], let mel = host["frontend.mel_banks"],
+            let kernel = host["frontend.resample_44100"], win.shape == [400],
+            mel.shape == [80, 257], kernel.shape == [160, 475]
+        else {
+            throw Zonos3Error.invalidCheckpoint("Missing speaker frontend arrays")
+        }
+        window = win.asType(.float64, stream: .cpu).asArray(Double.self)
+        melBanks = mel.asType(.float64, stream: .cpu).asArray(Double.self)
+        resampleKernel = kernel.asType(.float64, stream: .cpu)
+        for name in p.tables.keys.filter({ $0.hasSuffix(".w0") }) {
+            let prefix = String(name.dropLast(3))
+            var slots: [MLXArray] = []
+            while let weight = p.tables[prefix + ".w\(slots.count)"] { slots.append(weight) }
+            grouped[prefix] = concatenated(slots, axis: 1).transposed(0, 2, 3, 1)
+        }
+        eval(p.arrays + Array(grouped.values))
+    }
+
+    static func resample(_ pcm: MLXArray, kernel: MLXArray, orig: Int, new: Int, width: Int)
+        -> MLXArray
+    {
+        let length = pcm.size
+        let total = (new * length + orig - 1) / orig
+        if total == 0 { return .zeros([0]) }
+        let taps = 2 * width + orig
+        let blocks = (total + new - 1) / new
+        let right = max(0, (blocks - 1) * orig + taps - width - length)
+        let x = pcm.asType(.float64, stream: .cpu)
+        let padded = concatenated(
+            [
+                .zeros([width], dtype: .float64, stream: .cpu), x,
+                .zeros([right], dtype: .float64, stream: .cpu),
+            ], stream: .cpu)
+        let windows = asStrided(padded, [blocks, taps], strides: [orig, 1], stream: .cpu)
+        return matmul(windows, kernel.transposed(stream: .cpu), stream: .cpu)
+            .reshaped(-1, stream: .cpu)[0 ..< total, stream: .cpu].asType(.float32, stream: .cpu)
+    }
+
+    /// Double-precision FFT and accumulation preserve the published frontend's numerical behavior.
+    func fbank(_ waveform: [Float]) throws -> MLXArray {
+        let count = min(waveform.count, 960000)
+        guard count >= 400 else {
+            throw Zonos3Error.invalidInput("Speaker audio is shorter than 25 ms")
+        }
+        guard let fft = vDSP_DFT_zop_CreateSetupD(nil, 512, .FORWARD) else {
+            throw Zonos3Error.invalidInput("Could not initialize speaker FFT")
+        }
+        defer { vDSP_DFT_DestroySetupD(fft) }
+        let frames = 1 + (count - 400) / 160
+        var output = [Float](repeating: 0, count: frames * 80)
+        var real = [Double](repeating: 0, count: 512)
+        var imag = real
+        var fftReal = real
+        var fftImag = real
+        for t in 0 ..< frames {
+            let start = t * 160
+            let mean =
+                waveform[start ..< (start + 400)].reduce(0.0) { $0 + Double($1) * waveformScale }
+                / 400
+            var previous = Double(waveform[start]) * waveformScale - mean
+            for j in 0 ..< 400 {
+                let value = Double(waveform[start + j]) * waveformScale - mean
+                real[j] = (value - preemphasis * previous) * window[j]
+                previous = value
+            }
+            vDSP_DFT_ExecuteD(fft, real, imag, &fftReal, &fftImag)
+            var power = [Double](repeating: 0, count: 257)
+            for j in 0 ..< 257 { power[j] = fftReal[j] * fftReal[j] + fftImag[j] * fftImag[j] }
+            for mel in 0 ..< 80 {
+                var energy = 0.0
+                for j in 0 ..< 257 { energy += power[j] * melBanks[mel * 257 + j] }
+                output[t * 80 + mel] = Float(log(max(energy, logFloor)))
+            }
+        }
+        // Reference rounds fbank to FP32 before double-precision mean normalization.
+        var mean = [Double](repeating: 0, count: 80)
+        for t in 0 ..< frames {
+            for m in 0 ..< 80 { mean[m] += Double(output[t * 80 + m]) / Double(frames) }
+        }
+        for t in 0 ..< frames {
+            for m in 0 ..< 80 { output[t * 80 + m] = Float(Double(output[t * 80 + m]) - mean[m]) }
+        }
+        return MLXArray(output, [frames, 80])
+    }
+
+    private func bn(_ x: MLXArray, _ prefix: String) -> MLXArray {
+        x * p.t(prefix + ".scale") + p.t(prefix + ".shift")
+    }
+    private func linear(_ x: MLXArray, _ prefix: String, bias: Bool = true) -> MLXArray {
+        let w = p.t(prefix + ".weight")
+        let y = matmul(x, w.reshaped(w.dim(0), -1).T)
+        return bias ? y + p.t(prefix + ".bias") : y
+    }
+    private func ln(_ x: MLXArray, _ prefix: String) -> MLXArray {
+        zonos3LayerNorm(x, p, prefix, lnEps)
+    }
+    private func groupConv(_ x: MLXArray, _ prefix: String, _ sf: Int, _ st: Int) -> MLXArray {
+        let w = grouped[prefix]!
+        return conv2d(x, w, stride: .init((sf, st)), padding: 1, groups: x.dim(-1) / w.dim(-1))
+    }
+    private func residual(_ x: MLXArray, _ q: String, _ sf: Int, _ st: Int) -> MLXArray {
+        var t = groupConv(x, q + "conv1", sf, st)
+        t = maximum(bn(linear(t, q + "pw1"), q + "bn1"), 0)
+        t = groupConv(t, q + "conv2", 1, 1)
+        t = maximum(bn(linear(t, q + "pw2"), q + "bn2"), 0)
+        var sc = x
+        if p.tables[q + "sc.weight"] != nil {
+            sc = bn(
+                linear(x[0..., .stride(by: sf), .stride(by: st), 0...], q + "sc", bias: false),
+                q + "sc.bn")
+        }
+        return t + sc
+    }
+    private func attention(_ h: MLXArray, _ prefix: String) -> MLXArray {
+        let n = h.dim(0)
+        let heads = 4
+        let d = 16
+        func project(_ name: String) -> MLXArray {
+            linear(h, prefix + "attn." + name).reshaped(n, heads, d).transposed(1, 0, 2)[.newAxis]
+        }
+        let out = MLXFast.scaledDotProductAttention(
+            queries: project("q") / 4,
+            keys: project("k"), values: project("v"), scale: 1, mask: .none)[0]
+        return linear(out.transposed(1, 0, 2).reshaped(n, 64), prefix + "attn.o")
+    }
+    private func newGELU(_ x: MLXArray) -> MLXArray {
+        0.5 * x * (1 + tanh(sqrt(Float(2 / Double.pi)) * (x + 0.044715 * x * x * x)))
+    }
+    private func moe(_ h: MLXArray, _ prefix: String) -> MLXArray {
+        let r = softmax(matmul(h, p.t(prefix + "moe.gate.weight").T), axis: -1)
+        let experts = newGELU(matmul(h, p.t(prefix + "moe.experts.weight").T)).reshaped(
+            h.dim(0), -1, 64)
+        return linear(newGELU((experts * r[0..., 0..., .newAxis]).sum(axis: 1)), prefix + "ffn_out")
+    }
+    private func positional(_ h: MLXArray, _ prefix: String) -> MLXArray {
+        let w = p.t(prefix + "pos.dw.weight")
+        let padding = w.dim(1) / 2
+        let padded = concatenated([.zeros([padding, 64]), h, .zeros([padding, 64])])
+        var acc = conv1d(padded[.newAxis], w[0..., 0..., .newAxis], groups: 64)[0]
+        acc = bn(acc + p.t(prefix + "pos.dw.bias"), prefix + "pos.bn")
+        return linear(gelu(acc), prefix + "pos.pw")
+    }
+    private func flatten(_ x: MLXArray) -> MLXArray {
+        x[0].transposed(1, 0, 2).reshaped(x.dim(2), -1)
+    }
+    private func block(_ x: MLXArray, _ xf: MLXArray, depth: Int, sf: Int, st: Int, prefix: String)
+        -> (MLXArray, MLXArray)
+    {
+        let time = x.dim(2)
+        var y = x
+        for r in 0 ..< depth {
+            y = residual(y, prefix + "cnn.\(r).", r == 0 ? sf : 1, r == 0 ? st : 1)
+        }
+        if p.tables[prefix + "reduce.weight"] != nil {
+            y = bn(linear(y, prefix + "reduce"), prefix + "reduce.bn")
+        }
+        let frequency = y.dim(1)
+        let channels = y.dim(3)
+        let x2 = flatten(y)
+        var h = ln(linear(x2, prefix + "rproj"), prefix + "rproj.ln")
+        h = h + positional(h, prefix)
+        h = ln(h + attention(h, prefix), prefix + "ln1")
+        h = ln(h + moe(h, prefix), prefix + "ln2")
+        var e = linear(h, prefix + "eproj") + x2
+        if st > 1 { e = repeated(e, count: st, axis: 0)[0 ..< time] }
+        let out = e + xf
+        return (out.reshaped(out.dim(0), frequency, channels).transposed(1, 0, 2)[.newAxis], out)
+    }
+
+    func embed(_ pcm: MLXArray) throws -> MLXArray {
+        let wave = Self.resample(
+            pcm[0 ..< min(pcm.size, 60 * 44100)], kernel: resampleKernel, orig: 441, new: 160,
+            width: 17)
+        let features = try fbank(wave.asArray(Float.self))
+        var x = features.T[.newAxis, 0..., 0..., .newAxis]
+        let w = p.t("fe.head.conv.weight").transposed(0, 2, 3, 1)
+        x = bn(conv2d(x, w, padding: 1) + p.t("fe.head.conv.bias"), "fe.head.bn")
+        var xf = flatten(x)
+        var stages: [MLXArray] = []
+        for (stage, count) in [2, 4, 5, 3].enumerated() {
+            for b in 0 ..< count {
+                let sf = stage > 0 && b == 0 ? 2 : 1
+                let st = stage > 0 && b > 0 ? 2 : 1
+                (x, xf) = block(
+                    x, xf, depth: stage == 3 && b > 0 ? 2 : 3, sf: sf, st: st,
+                    prefix: "fe.b\(stage + 1).\(b).")
+                eval(x, xf)
+            }
+            stages.append(xf)
+        }
+        let dense = p.t("fe.dense_w")
+        var fused = stages[0] * dense[0]
+        for s in 1 ..< 4 { fused = fused + stages[s] * dense[s] }
+        let alpha = softmax(linear(tanh(linear(fused, "pool.l1")), "pool.l2"), axis: 0)
+        let mean = (alpha * fused).sum(axis: 0)
+        let variance = (alpha * fused * fused).sum(axis: 0) - mean * mean
+        let pooled = concatenated([mean, sqrt(maximum(variance, varianceFloor))])
+        let embedding = matmul(bn(pooled, "bn"), p.t("linear.weight").T)
+        eval(embedding)
+        guard all(isFinite(embedding)).item(Bool.self) else {
+            throw Zonos3Error.invalidInput("Non-finite speaker embedding")
+        }
+        return embedding
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Weights.swift b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Weights.swift
new file mode 100644
index 0000000..2e68ca3
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/Zonos3/Zonos3Weights.swift
@@ -0,0 +1,124 @@
+// Adapted from Zyphra's MIT-licensed ZONOS3-Mini runtime.
+import Foundation
+import MLX
+
+/// The published artifact uses encoded names and already-packed affine group-32 matrices.
+/// Keep these tensors in their native layout; no conversion or requantization is needed.
+final class Zonos3TensorStore {
+    let tables: [String: MLXArray]
+    let matrices: [String: Zonos3Matrix]
+
+    init(
+        specs: [String: Zonos3TensorSpecification], weights: [String: MLXArray], prefix: String = ""
+    ) throws {
+        var tables: [String: MLXArray] = [:]
+        var matrices: [String: Zonos3Matrix] = [:]
+        var expected = Set<String>()
+        for (name, spec) in specs {
+            guard !name.contains("__"), !spec.shape.isEmpty, spec.shape.allSatisfy({ $0 > 0 })
+            else {
+                throw Zonos3Error.invalidCheckpoint("Invalid tensor specification: \(name)")
+            }
+            let encoded = name.replacingOccurrences(of: ".", with: "__")
+            func tensor(_ key: String, shape: [Int], dtype: DType) throws -> MLXArray {
+                let full = prefix + key
+                expected.insert(full)
+                guard let value = weights[full], value.shape == shape, value.dtype == dtype else {
+                    throw Zonos3Error.invalidCheckpoint("Missing or incompatible tensor: \(full)")
+                }
+                return value
+            }
+            let dtype: DType
+            switch spec.dtype {
+            case "uint32": dtype = .uint32
+            case "float32": dtype = .float32
+            case "float16": dtype = .float16
+            case "bfloat16": dtype = .bfloat16
+            default: throw Zonos3Error.invalidCheckpoint("Unsupported dtype: \(spec.dtype)")
+            }
+            if spec.matrix {
+                let key = "matrices." + encoded
+                if let bits = spec.bits {
+                    guard [4, 8].contains(bits), spec.shape.count >= 2, spec.shape.last! % 32 == 0
+                    else {
+                        throw Zonos3Error.invalidCheckpoint("Unsupported packed matrix: \(name)")
+                    }
+                    var packed = spec.shape
+                    var groups = spec.shape
+                    packed[packed.count - 1] = packed.last! * bits / 32
+                    groups[groups.count - 1] /= 32
+                    matrices[name] = try Zonos3Matrix(
+                        weight: tensor(key + ".weight", shape: packed, dtype: .uint32),
+                        scales: tensor(key + ".scales", shape: groups, dtype: .float32),
+                        biases: tensor(key + ".biases", shape: groups, dtype: .float32), bits: bits)
+                } else {
+                    matrices[name] = try Zonos3Matrix(
+                        weight: tensor(key + ".weight", shape: spec.shape, dtype: dtype))
+                }
+            } else {
+                tables[name] = try tensor("tables." + encoded, shape: spec.shape, dtype: dtype)
+            }
+        }
+        guard Set(weights.keys) == expected else {
+            throw Zonos3Error.invalidCheckpoint(
+                "Unexpected checkpoint tensors: \(Set(weights.keys).subtracting(expected).sorted())"
+            )
+        }
+        self.tables = tables
+        self.matrices = matrices
+    }
+
+    func t(_ name: String) -> MLXArray { tables[name]! }
+    func lin(_ name: String, _ x: MLXArray, bias: String? = nil) -> MLXArray {
+        let y = matrices[name]!(x)
+        return bias.map { y + t($0) } ?? y
+    }
+    var arrays: [MLXArray] { Array(tables.values) + matrices.values.flatMap(\.arrays) }
+}
+
+struct Zonos3Matrix {
+    let weight: MLXArray
+    var scales: MLXArray? = nil
+    var biases: MLXArray? = nil
+    var bits: Int? = nil
+    var arrays: [MLXArray] { [weight] + [scales, biases].compactMap { $0 } }
+
+    func callAsFunction(_ x: MLXArray, indices: MLXArray? = nil) -> MLXArray {
+        if let bits, let scales {
+            if let indices {
+                return gatherQuantizedMM(
+                    x, weight, scales: scales, biases: biases,
+                    rhsIndices: indices, transpose: true, groupSize: 32, bits: bits)
+            }
+            return quantizedMM(
+                x, weight, scales: scales, biases: biases,
+                transpose: true, groupSize: 32, bits: bits)
+        }
+        let w = weight.asType(.float32).swappedAxes(-1, -2)
+        if let indices { return gatherMM(x, w, rhsIndices: indices) }
+        return matmul(x, w)
+    }
+}
+
+struct Zonos3Component {
+    let metadata: [String: Any]
+    let params: Zonos3TensorStore
+    init(_ directory: URL, architecture: String) throws {
+        let data = try Data(contentsOf: directory.appendingPathComponent("config.json"))
+        guard let object = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+            let metadata = object["metadata"] as? [String: Any],
+            metadata["general.architecture"] as? String == architecture,
+            let tensors = object["tensors"]
+        else {
+            throw Zonos3Error.invalidCheckpoint(
+                "Expected \(architecture) in \(directory.lastPathComponent)")
+        }
+        self.metadata = metadata
+        let specs = try JSONDecoder().decode(
+            [String: Zonos3TensorSpecification].self,
+            from: JSONSerialization.data(withJSONObject: tensors))
+        params = try Zonos3TensorStore(
+            specs: specs,
+            weights: loadArrays(url: directory.appendingPathComponent("model.safetensors")))
+    }
+}
