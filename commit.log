+    func primeStreamingState(referenceCodes: MLXArray, contextSize: Int = 25) {
+        let time = referenceCodes.dim(2)
+        guard contextSize > 0, time > 0 else { return }
+        _ = streamingStep(referenceCodes[0..., 0..., max(0, time - contextSize)...])
+    }
