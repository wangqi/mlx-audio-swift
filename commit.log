+        func decode(_ audio: MLXArray) -> STTOutput {
+            generate(
+                audio: audio,
+                beamSize: 3,
+                softmaxSmoothing: 1.25,
+                lengthPenalty: 0.6,
+                eosPenalty: 1.0,
