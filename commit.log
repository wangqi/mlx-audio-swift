+configs:
+  Debug: debug
+  Release: release
+
+packages:
+  mlx-audio-swift:
+    path: ../..
+  mlx-swift-lm:
+    url: https://github.com/ml-explore/mlx-swift-lm.git
+    exactVersion: 3.31.3
+  swift-huggingface:
+    url: https://github.com/huggingface/swift-huggingface.git
+    exactVersion: 0.8.1
+  swift-transformers:
+    url: https://github.com/huggingface/swift-transformers.git
+    exactVersion: 1.1.9
+
+targets:
+  SimpleChat:
+    type: application
+    platform: auto
+    supportedDestinations:
+      - iOS
+      - macOS
+    sources:
