commit e8450402ca60780a4532829eac92bbb2e57cfb6c
Author: ahuzmeza <32289581+ahuzmeza@users.noreply.github.com>
Date:   Sat Oct 31 01:50:42 2026 +0200

    VoxCPM2: feed multi-character Chinese tokens one character at a time (#356)
    
    OpenBMB's VoxCPM2 wraps its tokenizer with mask_multichar_chinese_tokens: a token that
    is a multi-character Chinese vocabulary entry is replaced by its characters, and the
    word-start marker is dropped. The model is trained on those single-character ids;
    Python mlx-audio does nearly the same since 6fd46e9, without the vocabulary check. The
    Swift port encoded Chinese text without the split, so the model got ids the reference
    never feeds it: 19,697 of the 73,448 ids are fed one character at a time, and
    "人工智能正在改变我们的生活方式。" went in as 7 tokens instead of 17.
    
    tokenize now maps each id through the same rule.
    
    multiCharacterChineseTokensAreFedOneCharacterAtATime covers the split, the dropped
    marker, and tokens that are kept.
    
    mlx-community/VoxCPM2-4bit, no reference audio, nine Chinese sentences (four of them
    short: 你好。谢谢你。今天天气很好。我们明天见。) x 3 runs after a warm-up, Release CLI, transcribed with
    mlx-audio Whisper large-v3-turbo (zh, simplified-Chinese prompt), character error
    rate with each clip's errors capped at the sentence length, on main d085589: 0.765 (3
    of 27 transcripts exact; one render was still going after 10 minutes, stopped and
    counted as wrong) -> 0.052 (24 of 27 exact); short sentences 0.692 -> 0.111.

diff --git a/Sources/MLXAudioTTS/Models/VoxCPM2/VoxCPM2Model.swift b/Sources/MLXAudioTTS/Models/VoxCPM2/VoxCPM2Model.swift
index ef70388..3d1f874 100644
--- a/Sources/MLXAudioTTS/Models/VoxCPM2/VoxCPM2Model.swift
+++ b/Sources/MLXAudioTTS/Models/VoxCPM2/VoxCPM2Model.swift
@@ -248,7 +248,24 @@ public final class VoxCPM2Model: Module, SpeechGenerationModel, @unchecked Senda
         if let last = ids.last, last == (tokenizer.eosTokenId ?? -1) {
             ids.removeLast()
         }
-        return ids
+        return ids.flatMap { Self.singleCharacterChineseIDs(for: $0, tokenizer: tokenizer) }
+    }
+
+    static func singleCharacterChineseIDs(for id: Int, tokenizer: Tokenizers.Tokenizer) -> [Int] {
+        guard let token = tokenizer.convertIdToToken(id) else { return [id] }
+        let word = token.replacingOccurrences(of: "▁", with: "")
+        let characters = word.unicodeScalars.map { String($0) }
+        guard characters.count >= 2,
+            word.unicodeScalars.allSatisfy({ (0x4E00 ... 0x9FFF).contains($0.value) }),
+            Self.vocabularyID(of: word, tokenizer: tokenizer) != nil
+        else { return [id] }
+        let ids = characters.compactMap { Self.vocabularyID(of: $0, tokenizer: tokenizer) }
+        return ids.count == characters.count ? ids : [id]
+    }
+
+    private static func vocabularyID(of token: String, tokenizer: Tokenizers.Tokenizer) -> Int? {
+        guard let id = tokenizer.convertTokenToId(token), id != tokenizer.unknownTokenId else { return nil }
+        return id
     }
 
     // MARK: - Generation
