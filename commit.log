-+    generationParameters: GenerateParameters(temperature: 0.8)
++    text: "Streaming synthesis with Kitten.",
++    voice: "Leo"
 +) {
 +    switch event {
 +    case .audio(let samples):
-+        // Process audio chunk
 +        break
 +    case .info(let info):
 +        print("Generated in \(info.generateTime)s")
 +    }
 +}
 +```
