commit 63f33f50fbd5ec822d0dedd644e99d2cbe623ce6
Author: Bruno Barbieri <1247834+brunobar79@users.noreply.github.com>
Date:   Tue May 19 11:30:00 2026 -0400

    fix(MossTTS): gate homeDirectoryForCurrentUser behind #if os(macOS) (#189)
    
    `FileManager.homeDirectoryForCurrentUser` is macOS-only and causes a
    compile error when building MLXAudioTTS for iOS:
    
        error: 'homeDirectoryForCurrentUser' is unavailable in iOS
    
    Gate the macOS path behind `#if os(macOS)` and fall back to the
    user's caches directory on iOS (and other non-macOS platforms),
    preserving the HuggingFace hub snapshot lookup behavior.

diff --git a/Sources/MLXAudioTTS/Models/MossTTS/MossTTSModel.swift b/Sources/MLXAudioTTS/Models/MossTTS/MossTTSModel.swift
index cfe21c8..49d4cac 100644
--- a/Sources/MLXAudioTTS/Models/MossTTS/MossTTSModel.swift
+++ b/Sources/MLXAudioTTS/Models/MossTTS/MossTTSModel.swift
@@ -355,7 +355,12 @@ public final class MossTTSModel: Module, SpeechGenerationModel, @unchecked Senda
     private static func findCachedHubSnapshot(repo: String) -> URL? {
         let components = repo.split(separator: "/", maxSplits: 1).map(String.init)
         guard components.count == 2 else { return nil }
+        #if os(macOS)
         let home = FileManager.default.homeDirectoryForCurrentUser
+        #else
+        let home = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask).first
+            ?? URL(fileURLWithPath: NSTemporaryDirectory())
+        #endif
         let snapshotsDir = home
             .appendingPathComponent(".cache/huggingface/hub", isDirectory: true)
             .appendingPathComponent("models--\(components[0])--\(components[1])", isDirectory: true)

