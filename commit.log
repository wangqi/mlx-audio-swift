+            heads: try c.decode(Int.self, forKey: .heads),
+            layers: try c.decode(Int.self, forKey: .layers),
+            maxMelTokens: try c.decode(Int.self, forKey: .maxMelTokens),
+            maxTextTokens: try c.decode(Int.self, forKey: .maxTextTokens),
