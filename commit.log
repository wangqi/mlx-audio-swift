-+/// Create periodic Hann window matching scipy fftbins=True.
-+func hannWindowPeriodic(size: Int) -> MLXArray {
-+    let values = (0 ..< size).map { n in
-+        Float(0.5 * (1.0 - cos(2.0 * Double.pi * Double(n) / Double(size))))
-+    }
-+    return MLXArray(values)
