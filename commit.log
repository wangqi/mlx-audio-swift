Author: ahuzmeza <32289581+ahuzmeza@users.noreply.github.com>
Date:   Tue Nov 3 21:13:24 2026 +0200

    Qwen3-TTS: apply the speech decoder's 72-frame sliding window (#369)
    
    * Qwen3-TTS: apply the speech decoder's 72-frame sliding window
    
    The decoder transformer built a full causal mask and an unbounded KV
    cache, so every frame after 5.76 s attended further back than the
    reference decoder, which masks every layer to sliding_window frames.
    Build the mask with createAttentionMask(windowSize:) and use a
    RotatingKVCache of sliding_window frames.
    
    * Relax Qwen3-TTS streaming parity tolerance for TF32
    
    ---------
    
    Co-authored-by: Lucas Newman <lucasnewman@me.com>

diff --git a/Sources/MLXAudioTTS/Models/Qwen3TTS/Qwen3TTSSpeechTokenizer.swift b/Sources/MLXAudioTTS/Models/Qwen3TTS/Qwen3TTSSpeechTokenizer.swift
index 21f47af..37ac983 100644
--- a/Sources/MLXAudioTTS/Models/Qwen3TTS/Qwen3TTSSpeechTokenizer.swift
+++ b/Sources/MLXAudioTTS/Models/Qwen3TTS/Qwen3TTSSpeechTokenizer.swift
@@ -482,13 +482,12 @@ final class DecoderTransformer: Module {
         let posEmb = rotaryEmb(x, positionIds: posIds)
 
         var causalMask = mask
-        if causalMask == nil, seqLen > 1 {
-            let totalLen = offset + seqLen
-            var fullMask = MultiHeadAttention.createAdditiveCausalMask(totalLen).asType(x.dtype)
-            if totalLen > seqLen {
-                fullMask = fullMask[(totalLen - seqLen) ..< totalLen, 0...]
-            }
-            causalMask = fullMask
+        if causalMask == nil, seqLen > 1,
+           case .array(let windowMask) = createAttentionMask(
+               h: x, cache: cache?.first, windowSize: config.slidingWindow, returnArray: true
+           )
+        {
+            causalMask = windowMask
         }
 
         for (i, layer) in layers.enumerated() {
@@ -498,7 +497,7 @@ final class DecoderTransformer: Module {
     }
 
     func makeCache() -> [any KVCache] {
-        layers.map { _ in KVCacheSimple() }
+        layers.map { _ in RotatingKVCache(maxSize: config.slidingWindow) }
     }
 }
 
