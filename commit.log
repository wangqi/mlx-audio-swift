+struct MimiStreamingTests {
+
+    private func makeTinyMimi() throws -> Mimi {
+        let seanet = SeanetConfig(
+            dimension: 8, channels: 1, causal: true, nfilters: 2, nresidualLayers: 1, ratios: [2, 2],
+            ksize: 3, residualKsize: 3, lastKsize: 3, dilationBase: 2, padMode: .constant, trueSkip: true, compress: 2
+        )
+        let transformer = TransformerConfig(
+            dModel: 8, numHeads: 2, numLayers: 1, causal: true, normFirst: true, biasFF: false, biasAttn: false,
+            layerScale: 0.01, positionalEmbedding: "rope", useConvBlock: false, crossAttention: false,
+            convKernelSize: 3, useConvBias: true, gating: false, norm: "layer_norm", context: 16, maxPeriod: 10_000,
+            maxSeqLen: 64, kvRepeat: 1, dimFeedforward: 16, convLayout: true
+        )
+        return try withRandomState(MLXRandom.RandomState(seed: 0)) {
+            let mimi = Mimi(cfg: MimiConfig(
+                channels: 1, sampleRate: 80, frameRate: 10, renormalize: true, seanet: seanet,
+                transformer: transformer, quantizerNQ: 2, quantizerBins: 8, quantizerDim: 4
+            ))
+            let codebooks = mimi.parameters().flattened().compactMap { key, value -> (String, MLXArray)? in
+                if key.hasSuffix("embedding_sum") { return (key, MLXRandom.normal(value.shape)) }
+                if key.hasSuffix("cluster_usage") { return (key, MLXArray.ones(value.shape)) }
+                return nil
+            }
+            try mimi.update(parameters: ModuleParameters.unflattened(codebooks), verify: .none)
+            return mimi
+        }
+    }
+
+    @Test func resetStateStartsTheNextStreamFresh() throws {
+        let (first, second) = withRandomState(MLXRandom.RandomState(seed: 1)) {
+            (MLXRandom.uniform(low: -1, high: 1, [1, 1, 36]), MLXRandom.uniform(low: -1, high: 1, [1, 1, 64]))
+        }
+
+        let mimi = try makeTinyMimi()
+        eval(mimi.encodeStep(first))
+        mimi.resetState()
+        let codes = mimi.encodeStep(second)
+        let expected = try makeTinyMimi().encodeStep(second)
+        eval(codes, expected)
+
+        #expect(codes.shape == [1, 2, 8])
+        #expect(codes.shape == expected.shape)
+        #expect(MLX.all(codes .== expected).item(Bool.self))
+    }
+}

commit b79cfe43f6a9ba56224570eb9fa76ecfa9dbea92
Author: ahuzmeza <32289581+ahuzmeza@users.noreply.github.com>
Date:   Mon Nov 2 18:23:38 2026 +0200

    Mimi: return no codes from encodeStep when no frame completes (#367)
    
    Streaming Mimi emits a code only once a whole frame (1,920 samples at 24 kHz)
    is buffered. A step that completes no frame passed an empty sequence to the
    quantizer, whose convolution ended the process with a fatalError ("[conv]
    Spatial dimensions of input after padding cannot be smaller than weight
    spatial dimensions"). encodeStep now returns codes of length 0 for such a
    step; the samples stay buffered for the next one.
    
    Marvis hits it on every reference clip of 48,000 * k + r samples with k >= 1
    and 0 < r < 1,920: encodeChunked feeds the reference in 48,000-sample chunks,
    so the last chunk holds less than one frame. Other references take the same
    path as before. A reference shorter than one frame now throws
    invalidRefAudio instead of crashing.
    
    The test streams a tiny random Mimi with a last step shorter than one frame,
    and a first step shorter than one frame, and expects empty codes for both.

diff --git a/Sources/MLXAudioCodecs/Mimi/Mimi.swift b/Sources/MLXAudioCodecs/Mimi/Mimi.swift
index 46b5a44..f36ca67 100644
--- a/Sources/MLXAudioCodecs/Mimi/Mimi.swift
+++ b/Sources/MLXAudioCodecs/Mimi/Mimi.swift
@@ -185,9 +185,12 @@ public final class Mimi: Module {
     }
 
     public func encodeStep(_ xs: MLXArray) -> MLXArray {
+        let noFrames = MLXArray.zeros([xs.dim(0), cfg.quantizerNQ, 0], type: UInt32.self)
         var z = encoder.step(xs)
+        if z.dim(-1) == 0 { return noFrames }
         z = encoder_transformer(z, cache: encoderCache)[0]
         z = downsample.step(z)
+        if z.dim(-1) == 0 { return noFrames }
         z = quantizer.encode(z)
         return z
     }
