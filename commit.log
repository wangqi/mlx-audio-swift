-+        return fallback
-+    }
-+
-+    func mossString(_ key: String, fallback: String) -> String {
-+        (self[key] as? String) ?? fallback
-+    }
-+}
-+
-+private extension Dictionary where Key == String, Value == SendableValue {
-+    func int(_ key: String, fallback: Int) -> Int {
