+            "hop_length": 128,
+            "pad": 64,
+            "cutoff": 129,
+            "context_size": 64,
+            "chunk_size": 512
+          }
+        }
+        """#.data(using: .utf8)!
+        let config = try JSONDecoder().decode(SileroVADConfig.self, from: json)
+        #expect(config.minSpeechDurationMs == 250)
+        #expect(config.branch16k.cutoff == 129)
